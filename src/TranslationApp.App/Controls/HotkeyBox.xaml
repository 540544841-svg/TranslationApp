<UserControl x:Class="TranslationApp.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="{StaticResource Height.Large}">
    <!--
      热键录制框（FR-009）：
      未录制时把热键显示为「按键帽」（修饰键 + 主键分开），比纯文本更易读；
      聚焦即进入录制态（主色描边 + 提示文字）；冲突/非法时转为错误态描边。
      状态用 DataTrigger 驱动，逻辑在 HotkeyBox.xaml.cs。
    -->
    <Border x:Name="RootBorder" Height="{StaticResource Height.Large}"
            Background="{DynamicResource Brush.SurfaceSubtle}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Control}"
            Cursor="Hand" Focusable="True"
            GotKeyboardFocus="OnBoxGotFocus"
            LostKeyboardFocus="OnBoxLostFocus"
            PreviewKeyDown="OnBoxPreviewKeyDown"
            MouseLeftButtonDown="OnRootMouseDown">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecording, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                        <Setter Property="Background" Value="{DynamicResource Brush.Window}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsInvalid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                        <Setter Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="8,0">
            <!-- 录制中：提示文字 -->
            <TextBlock x:Name="RecordingHint" Text="请按下组合键…"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSize.Small}"
                       Foreground="{DynamicResource Brush.PrimaryText}"/>
            <!-- 按键帽 -->
            <ItemsControl x:Name="Keycaps" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Window}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Chip}"
                                Padding="7,3" Margin="0,0,4,0">
                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontWeight="{StaticResource Weight.Medium}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 空值提示 -->
            <TextBlock x:Name="EmptyHint" Text="未设置"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSize.Small}"
                       Foreground="{DynamicResource Brush.TextDisabled}"/>
        </Grid>
    </Border>
</UserControl>
