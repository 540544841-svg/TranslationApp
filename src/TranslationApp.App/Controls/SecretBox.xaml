<UserControl x:Class="TranslationApp.Controls.SecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!--
      密钥输入控件（13.1.6）：默认以密码框遮显，右侧「显示/隐藏」按钮可临时切到明文查看。
      明文仅在内存与界面中使用，落盘一律走 SecretStore.Protect 加密（FR-010）。
      颜色/字阶/圆角全部引用语义令牌，不写死颜色。
    -->
    <Grid>
        <PasswordBox x:Name="Hidden" Style="{StaticResource Field.PasswordBox}"
                     Padding="10,0,30,0"
                     PasswordChanged="OnHiddenPasswordChanged"/>

        <TextBox x:Name="Plain" Style="{StaticResource Field.TextBox}"
                 Height="{StaticResource Height.Control}" Padding="10,0,30,0"
                 FontSize="{StaticResource FontSize.Small}"
                 VerticalContentAlignment="Center"
                 Visibility="Collapsed"
                 TextChanged="OnPlainTextChanged"/>

        <Button x:Name="RevealButton" Style="{StaticResource IconButton}"
                Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,4,0" ToolTip="显示密钥"
                Click="OnRevealClick">
            <TextBlock x:Name="RevealGlyph" Style="{StaticResource Text.Icon}"
                       FontSize="{StaticResource FontSize.Small}"/>
        </Button>
    </Grid>
</UserControl>
