                        <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0"><TextBlock Text="04" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/></Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock Text="热键" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="HOTKEYS" Style="{StaticResource SectionEyebrow}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="点录制框直接按键即可修改；被系统或其他软件占用时当场标红。" Style="{StaticResource SectionDescription}"/>
                    </Grid>
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="全局热键" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="划词翻译" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="选中文字后按下，自动取词并落印" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:HotkeyBox x:Name="SelectHotkeyEditor" Text="{Binding HotkeySelectText}" IsInvalid="{Binding HotkeySelectInvalid}"
                                                                Status="{Binding HotkeySelectStatus}" Suggestions="{Binding HotkeySelectSuggestions}"/>
                                            <Button x:Name="ResetSelectHotkeyButton" Content="恢复默认" Style="{StaticResource Button.Outline}" Margin="10,0,0,0"
                                                    Command="{Binding ResetHotkeyCommand}" CommandParameter="Select"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="输入翻译" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="在鼠标处呼出小窗，直接输入文字翻译" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:HotkeyBox x:Name="InputHotkeyEditor" Text="{Binding HotkeyInputText}" IsInvalid="{Binding HotkeyInputInvalid}"
                                                                Status="{Binding HotkeyInputStatus}" Suggestions="{Binding HotkeyInputSuggestions}"/>
                                            <Button x:Name="ResetInputHotkeyButton" Content="恢复默认" Style="{StaticResource Button.Outline}" Margin="10,0,0,0"
                                                    Command="{Binding ResetHotkeyCommand}" CommandParameter="Input"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>


                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="截图翻译" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="冻结鼠标所在屏幕，框选后自动识别文字并翻译" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:HotkeyBox x:Name="CaptureHotkeyEditor" Text="{Binding HotkeyCaptureText}" IsInvalid="{Binding HotkeyCaptureInvalid}"
                                                                Status="{Binding HotkeyCaptureStatus}" Suggestions="{Binding HotkeyCaptureSuggestions}"/>
                                            <Button x:Name="ResetCaptureHotkeyButton" Content="恢复默认" Style="{StaticResource Button.Outline}" Margin="10,0,0,0"
                                                    Command="{Binding ResetHotkeyCommand}" CommandParameter="Capture"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- FR-037（P0 批 2）：场景档案循环切换热键 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="原位替换" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="译文直接覆盖原选区，不显示确认弹窗，按 Ctrl+Z 可撤销" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:HotkeyBox x:Name="ReplaceHotkeyEditor" Text="{Binding HotkeyReplaceText}" IsInvalid="{Binding HotkeyReplaceInvalid}"
                                                                Status="{Binding HotkeyReplaceStatus}" Suggestions="{Binding HotkeyReplaceSuggestions}"/>
                                            <Button x:Name="ResetReplaceHotkeyButton" Content="恢复默认" Style="{StaticResource Button.Outline}" Margin="10,0,0,0"
                                                    Command="{Binding ResetHotkeyCommand}" CommandParameter="Replace"/>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                      IsChecked="{Binding ReplaceSelectionEnabled}" ToolTip="默认关闭，避免误替换"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="场景档案循环" Style="{StaticResource RowLabel}"/>
