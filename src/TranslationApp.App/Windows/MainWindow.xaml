                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:HotkeyBox x:Name="ProfileHotkeyEditor" Text="{Binding HotkeyProfileText}" IsInvalid="{Binding HotkeyProfileInvalid}"
                                                                Status="{Binding HotkeyProfileStatus}" Suggestions="{Binding HotkeyProfileSuggestions}"/>
