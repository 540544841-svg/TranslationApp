<Window x:Class="TranslationApp.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TranslationApp.Controls"
        xmlns:vm="clr-namespace:TranslationApp.ViewModels"
        xmlns:local="clr-namespace:TranslationApp.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="译印 INKSEAL · 设置" Width="1140" Height="780"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.App}" FontSize="{StaticResource FontSize.Body}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- FR-024 引擎页：按字段类型 / 状态显隐输入控件与提示条 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <!-- 分段控件（设计稿 .seg）：把「当前值 == 本枚参数」比成 bool，供主题三态用 -->
        <local:ValueEqualsConverter x:Key="ValueEquals"/>
        <!-- FR-057：印谱行照设计稿 .log .li（引擎胶囊 · 原文 · 译文 · 时间 · 星标）。
             平铺与分组共用一份；行内动作默认收起，悬停时占据右侧「时间 + 星标」的位置，
             因此不改变行高、也不把星标挤走。星标本体就是「固定」开关，已固定为藏印金。 -->
        <DataTemplate x:Key="HistoryRowTemplate">
            <Border x:Name="Row" Style="{StaticResource LogRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,11,0">
                        <Border Style="{StaticResource Tag.Bad}" Margin="0,0,6,0"
                                Visibility="{Binding Rejected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="禁用复用" FontSize="11.5"/>
                        </Border>
                        <Border Style="{StaticResource Tag.Vermilion}" Margin="0,0,6,0"
                                Visibility="{Binding Reviewed, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="已校对" FontSize="11.5" Foreground="{DynamicResource Brush.PrimaryText}"/>
                        </Border>
                        <Border Style="{StaticResource Tag.Line}">
                            <TextBlock Text="{Binding EngineShort}" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SourceSummary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,11,0" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="{Binding TranslatedSummary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,11,0" FontSize="13"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <Grid Grid.Column="3">
                        <StackPanel x:Name="Rest" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CreatedAtRelative}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextTertiary}"/>
                            <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="7,0,0,0"
                                    ToolTip="固定 / 取消固定该条译文"
                                    Command="{Binding DataContext.TogglePinHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Viewbox Width="15" Height="15">
                                    <Path x:Name="Star" Style="{StaticResource Icon.Line}"
                                          Data="{StaticResource Glyph.Star}"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="Actions" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                    ToolTip="编辑译文 / 校对状态"
                                    Command="{Binding DataContext.EditHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Viewbox Width="15" Height="15">
                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Edit}"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                    ToolTip="标记 / 取消「已校对」"
                                    Command="{Binding DataContext.ToggleHistoryReviewedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Viewbox Width="15" Height="15">
                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Check}"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                    ToolTip="禁止 / 允许该条被 TM 复用"
                                    Command="{Binding DataContext.ToggleHistoryRejectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Viewbox Width="15" Height="15">
                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Close}"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                    ToolTip="把这条译法加入定制印"
                                    Command="{Binding DataContext.AddHistoryToGlossaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Viewbox Width="15" Height="15">
                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Add}"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                    ToolTip="复制原文与译文"
                                    Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Viewbox Width="15" Height="15">
                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Copy}"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                    ToolTip="删除该条"
                                    Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Viewbox Width="15" Height="15">
                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Delete}"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter TargetName="Star" Property="Path.Stroke" Value="{DynamicResource Brush.SealGold}"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Rest" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 分组的组标题行；记录行复用 HistoryRowTemplate -->
        <DataTemplate x:Key="HistoryHeaderTemplate">
            <Border Background="{DynamicResource Brush.SurfaceSubtle}" Padding="16,7"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,72,0"/>
                    <Button Content="{Binding ToggleText}" HorizontalAlignment="Right"
                            Style="{StaticResource Button.Outline}" Padding="8,2" Height="22" FontSize="11.5"
                            Command="{Binding DataContext.ToggleHistoryGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- 历史页单层虚拟化：分组标题与记录在同一 ListBox 中渲染 -->
        <DataTemplate x:Key="HistoryItemTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:HistoryHeaderRow}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HistoryHeaderTemplate}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryRecordRow}">
                        <ContentPresenter Content="{Binding Record}" ContentTemplate="{StaticResource HistoryRowTemplate}"/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </DataTemplate>

    </Window.Resources>
    <!--
      FR-009：左侧导航式设置窗口（对齐 Windows 11 设置 / macOS 系统设置的导航习惯），
      配置即时保存（无「确定」按钮）；窗口关闭 = 隐藏（托盘常驻）。
      每个 TabItem 的 Tag 提供导航图标字形，由 Themes/Controls.xaml 的 NavItem 模板渲染。
    -->
    <TabControl x:Name="NavTabs" Style="{StaticResource TabControl.Nav}" ItemContainerStyle="{StaticResource NavItem}" Margin="0"
                SelectionChanged="OnNavSelectionChanged">


        <!-- ==================== 工作台（首页）==================== -->

        <!-- ==================== 通用 ==================== -->
        <!-- ==================== 工作台（首页）—— 对齐 design-v4/inkseal-ui.html §设置·工作台 -->
        <TabItem Header="工作台" Tag="{StaticResource Glyph.Desk}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,26,32,44">
                <StackPanel DataContext="{Binding Workbench}">

                    <!-- st-head：方菱形（落在骑缝线上）+ 印面标 + 标题 + 信条（设计稿 .st-head / .st-creed）-->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="12" Height="12" Style="{StaticResource Diamond}"
                                Margin="7,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="26,0,0,0">
                            <Path Style="{StaticResource BrandMark}" Width="26" Height="26" Margin="0,2,13,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="工作台" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="WORKBENCH" Style="{StaticResource SectionEyebrow}"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- 信条：白印面 + 左侧一道朱砂竖痕，句尾收一粒方菱形。
                             它代替一段说明文字——第一次打开不需要读介绍，看一眼就懂这个工具在承诺什么。 -->
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Brand.Radius.Seal}"
                                Padding="15,10,14,11" VerticalAlignment="Top">
                            <Grid>
                                <Border Width="3" HorizontalAlignment="Left" Margin="-15,0,0,0"
                                        Background="{DynamicResource Brush.Primary}"/>
                                <StackPanel HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="印落，字才算数" FontSize="14.5" FontWeight="{StaticResource Weight.Semibold}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                        <Border Width="5" Height="5" Style="{StaticResource GroupDiamond}"
                                                Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="TWO SHORES · ONE SEAL" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                               Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,5,0,0"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- wb-strip：今日印记（设计稿 .wb-strip）。左边七枚骑缝齿，前三枚已盖印。
                         四个数字全是真实发生过的动作：今日落印跨重启，其余三个本次运行累计。 -->
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="{StaticResource Brand.Radius.Seal}"
                            Padding="14,9" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource ChiselTick}" Background="{DynamicResource Brush.Primary}"/>
                                    <Border Style="{StaticResource ChiselTick}" Background="{DynamicResource Brush.Primary}"/>
                                    <Border Style="{StaticResource ChiselTick}" Background="{DynamicResource Brush.Primary}"/>
                                    <Border Style="{StaticResource ChiselTick}"/>
                                    <Border Style="{StaticResource ChiselTick}"/>
                                    <Border Style="{StaticResource ChiselTick}"/>
                                    <Border Style="{StaticResource ChiselTick}" Margin="0"/>
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextTertiary}">
                                    <Run Text="今日落印"/><Run Text="{Binding TodaySealCount, Mode=OneWay}" FontFamily="{StaticResource Font.App}" FontSize="12.5" FontWeight="{StaticResource Weight.Semibold}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <Run Text="   ·   " Foreground="{DynamicResource Brush.TextDisabled}"/>
                                    <Run Text="印谱命中"/><Run Text="{Binding SessionSealHits, Mode=OneWay}" FontFamily="{StaticResource Font.App}" FontSize="12.5" FontWeight="{StaticResource Weight.Semibold}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <Run Text="   ·   " Foreground="{DynamicResource Brush.TextDisabled}"/>
                                    <Run Text="定制印"/><Run Text="{Binding SessionGlossaryHits, Mode=OneWay}" FontFamily="{StaticResource Font.App}" FontSize="12.5" FontWeight="{StaticResource Weight.Semibold}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <Run Text="   ·   " Foreground="{DynamicResource Brush.TextDisabled}"/>
                                    <Run Text="平均"/><Run Text="{Binding SessionAverageElapsedDisplay, Mode=OneWay}" FontFamily="{StaticResource Font.App}" FontSize="12.5" FontWeight="{StaticResource Weight.Semibold}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Tag.Line}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DataContext.WorkbenchSceneTag, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Border>
                                <Border Style="{StaticResource Tag}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DataContext.WorkbenchPrivacyTag, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Border>
                                <Border Style="{StaticResource Tag.Vermilion}">
                                    <TextBlock Text="{Binding DataContext.WorkbenchEngineTag, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="11.5" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 主网格：左卡片 + 右侧栏（对齐设计稿 .wb 双列）-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="420"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="292"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：印面卡片 -->
                        <StackPanel Grid.Column="0">
                            <!-- 印面 = 白（纸模式下比底色亮一级），阴刻区才是灰的。
                                 之前整张卡用 SurfaceSubtle，纸模式下就变成灰卡叠在灰底上，层次全没了。 -->
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="158"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- wb-bar -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="13,0,8,0" Height="44">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 语言对：阴刻底上的两粒按钮（设计稿 .langpair）-->
                                            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                                                    CornerRadius="{StaticResource Brand.Radius.Control}" Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- 设计稿 .lang：刻痕底上的无框文字按钮，宽度由文字自己撑（不设固定宽，否则药丸会比稿子宽一截） -->
                                                    <ComboBox BorderThickness="0" Background="Transparent" Height="24" FontSize="12.5"
                                                              Padding="4,0" FocusVisualStyle="{x:Null}"
                                                              ItemsSource="{Binding SourceOptions}" SelectedValue="{Binding SourceLanguage}"
                                                              SelectedValuePath="Code" DisplayMemberPath="Display"/>
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="互换语言（Ctrl+Enter）"
                                                            Command="{Binding SwapCommand}" VerticalAlignment="Center">
                                                        <Viewbox Width="12" Height="12">
                                                            <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Swap}"/>
                                                        </Viewbox>
                                                    </Button>
                                                    <ComboBox BorderThickness="0" Background="Transparent" Height="24" FontSize="12.5"
                                                              Padding="4,0" FocusVisualStyle="{x:Null}"
                                                              ItemsSource="{Binding TargetOptions}" SelectedValue="{Binding TargetLanguage}"
                                                              SelectedValuePath="Code" DisplayMemberPath="Display"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource Tag.Vermilion}" Margin="8,0">
                                                <TextBlock Text="手动输入" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}" FontWeight="{StaticResource Weight.Medium}"/>
                                            </Border>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="朗读原文（Ctrl+Shift+S）" Command="{Binding SpeakSourceCommand}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Speak}"/>
                                                    </Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="清空（Esc）" Command="{Binding ClearCommand}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Close}"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- wb-src 阴刻底 + 输入（设计稿 .wb-src：carved 底 + 上缘一道内阴影）-->
                                    <Border Grid.Row="1" Background="{DynamicResource Brush.Sidebar}" MinHeight="104">
                                        <Grid>
                                            <!-- 内阴影：WPF 没有 inset shadow，用一道自上而下淡出的墨痕代替 -->
                                            <Border VerticalAlignment="Top" Height="10" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#1418120E" Offset="0"/>
                                                        <GradientStop Color="#0018120E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- 空态提示落在阴刻区左上角（设计稿 .wb-src .txt:empty::before），不占位、不吃点击 -->
                                            <TextBlock Text="输入或粘贴要翻译的内容，按 Ctrl+Enter 落印…" IsHitTestVisible="False"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,17,20,0"
                                                       FontSize="15" Foreground="{DynamicResource Brush.TextDisabled}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=WorkbenchInputBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="WorkbenchInputBox" BorderThickness="0" Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" Padding="0" Margin="20,16,20,18"
                                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="15" TextBlock.LineHeight="27"
                                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                                     CaretBrush="{DynamicResource Brush.Primary}"
                                                     PreviewKeyDown="OnWorkbenchInputKeyDown"/>
                                        </Grid>
                                    </Border>

                                    <!-- wb-seam 骑缝线 + 加载进度：刻痕右端收一粒方菱形（设计稿 .carve）-->
                                    <Border Grid.Row="2" Height="22" Padding="20,0">
                                        <Grid VerticalAlignment="Center">
                                            <ProgressBar Style="{StaticResource Progress.Indeterminate}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                                            <Grid Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,3,0"/>
                                                <Border Width="6" Height="6" Style="{StaticResource GroupDiamond}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- wb-dst 译文（设计稿 .wb-dst：四角阳刻细角 + 落定时右上角一方印面标）-->
                                    <Grid Grid.Row="3">
                                        <Border Style="{StaticResource SealCorner}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                BorderThickness="1,1,0,0"/>
                                        <Border Style="{StaticResource SealCorner}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                BorderThickness="0,0,1,1"/>
                                        <!-- 落定后常驻的印面标：提醒「这一句已经盖过章了」-->
                                        <Path Style="{StaticResource BrandMark}" Width="22" Height="22"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,14,0"
                                              Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"/>
                                        <Border Padding="20,20,20,22" MinHeight="158">
                                            <Grid>
                                                <!-- 译文主行 + 副行（副行是定制印命中说明；设计稿 .dst-text / .dst-sub）-->
                                                <StackPanel VerticalAlignment="Top"
                                                            Visibility="{Binding IsSingleResultVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- 译文用只读 TextBox：TextBlock 选不中，只能靠下方按钮整段复制；
                                                         换成只读输入框才能拖选一个词、一句话单独复制（与小窗译文的做法一致） -->
                                                    <TextBox Style="{StaticResource Field.ReadOnlyResult}"
                                                             Text="{Binding ResultText, Mode=OneWay}"
                                                             TextWrapping="Wrap" Padding="0" Margin="0"
                                                             VerticalScrollBarVisibility="Disabled"
                                                             FocusVisualStyle="{x:Null}"
                                                             FontSize="25" TextBlock.LineHeight="36"
                                                             FontWeight="{StaticResource Weight.Semibold}"
                                                             Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <!-- 副行（设计稿 .dst-sub）：一句人话交代这一句的来路 -->
                                                    <TextBlock Text="{Binding ResultSubText}" TextWrapping="Wrap" FontSize="13.5" LineHeight="23" Margin="0,9,0,0"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                                               Visibility="{Binding HasResultSubText, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="13.5"
                                                           Foreground="{DynamicResource Brush.Error}"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                                                <!-- 空态（设计稿 .dst-empty）：一枚灰印痕 + 一句动词提示，落在印面左上角 -->
                                                <StackPanel Orientation="Horizontal" Height="56" VerticalAlignment="Top"
                                                            Visibility="{Binding IsResultPlaceholderVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <Border Width="6" Height="6" Style="{StaticResource Diamond}" Background="{DynamicResource Brush.BorderStrong}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="输入或粘贴要翻译的内容，按 Ctrl+Enter 落印" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- wb-foot 印记行（设计稿 .wb-foot）：骑缝齿 + 印文 + 四个落印动作 -->
                                    <Border Grid.Row="4" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,10,12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 齿：第一枚朱砂 = 这一句已经盖过章 -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource ChiselTick}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border Style="{StaticResource ChiselTick}"/>
                                                <Border Style="{StaticResource ChiselTick}" Margin="0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding LastEngineName}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="{StaticResource Weight.Medium}" VerticalAlignment="Center"
                                                           Visibility="{Binding HasImprintEngine, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="11" VerticalAlignment="Center"
                                                           Visibility="{Binding HasElapsed, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding ElapsedDisplay}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                                                           Visibility="{Binding HasElapsed, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="11" VerticalAlignment="Center"
                                                           Visibility="{Binding HasImprintEngine, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="已落印" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="朗读译文" Command="{Binding SpeakResultCommand}"
                                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.SpeakWave}"/>
                                                    </Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="复制译文" Command="{Binding CopyResultCommand}"
                                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Copy}"/>
                                                    </Viewbox>
                                                </Button>
                                                <!-- 收进藏印（生词本）：收藏后换成实心星与朱砂 -->
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="收进藏印（生词本）"
                                                        Command="{Binding ToggleFavoriteCommand}"
                                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Data="{StaticResource Glyph.Star}">
                                                            <Path.Style>
                                                                <Style TargetType="Path" BasedOn="{StaticResource Icon.Line}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorited}" Value="True">
                                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.PrimaryText}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Viewbox>
                                                </Button>
                                                <!-- 对比引擎：工作台比小窗多出来的那一步（小窗只能复制，这里能把同一句再交给其他引擎）-->
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{Binding CompareToolTip}"
                                                        Command="{Binding ToggleCompareCommand}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Compare}"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- wb-run 操作行（设计稿 .wb-run）：主动作只有「落印」，清空是低调的次动作 -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource Button.Primary}" Height="34" Padding="22,0" Command="{Binding TranslateCommand}" MinWidth="110">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Style="{StaticResource Icon.Line.On}" Data="{StaticResource Glyph.SealCheck}"/>
                                        </Viewbox>
                                        <TextBlock Text="落印" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="清空" Style="{StaticResource Button.Link}" Height="26" Padding="12,0" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding ClearCommand}"/>
                                <TextBlock Text="Ctrl+Enter 落印 · Esc 清空 · 与 Alt+D 小窗共用同一套引擎、定制印与藏印" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>

                        <!-- wb-fold：同一格的两个面（设计稿 .wb-fold）——
                             没开对比时讲品牌内核，开了就换成两方印面。两者互斥，永远不会同时出现。 -->
                        <Grid Margin="0,12,0,0">
                        <!-- 对比引擎：工作台与小窗的差异点。小窗只能复制，这里点任一列就能采用。 -->
                        <Border x:Name="WorkbenchCompare" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Brand.Radius.Seal}" ClipToBounds="True"
                                Visibility="{Binding IsComparisonVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="14,9" Background="{DynamicResource Brush.Window}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="5" Height="5" Style="{StaticResource GroupDiamond}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <TextBlock Grid.Column="1" Text="对比引擎" FontSize="12" FontWeight="{StaticResource Weight.Semibold}" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="上方那句同时再交给两个引擎 · 点任一列即可替换上方译文" Margin="10,0,0,0" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                ToolTip="收起对比" Command="{Binding ToggleCompareCommand}">
                                            <Viewbox Width="12" Height="12">
                                                <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.ChevronUp}"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                                <!-- 列与列之间只隔 1px 发丝线：容器底色是线，列自己铺印面 -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding CompareItems}"
                                              Background="{DynamicResource Brush.Border}" Margin="0,0,-1,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 整列可点：点一下就把这一栏的译文提成上方正式译文 -->
                                            <Button Command="{Binding AdoptCommand}" Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root" Background="{DynamicResource Brush.Surface}" Margin="0,0,1,0" Padding="15,12,15,14">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource Tag}">
                                                            <TextBlock Text="{Binding EngineName}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Style="{StaticResource Tag.Line}" Margin="7,0,0,0">
                                                            <TextBlock Text="对比引擎" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="采用" FontSize="11" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="0"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <ProgressBar Height="2" Margin="0,8,0,0" IsIndeterminate="True"
                                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11.5"
                                                               Foreground="{DynamicResource Brush.Error}"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <!-- 品牌故事：对比引擎未展开时，这一格讲品牌内核（与两方印面互斥）-->
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Brand.Radius.Seal}" ClipToBounds="True"
                                Visibility="{Binding IsComparisonVisible, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid>
                                <!-- 左侧 3px 朱砂竖条（设计稿 .wb-story::before）-->
                                <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource Brush.Primary}"/>
                                <StackPanel Margin="16,13,16,14">
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center" Margin="1,0,9,0"/>
                                        <TextBlock Grid.Column="1" Text="为什么叫「译印」" FontSize="12" FontWeight="{StaticResource Weight.Semibold}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock Grid.Column="2" Text="WHY INKSEAL" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                    </Grid>
                                    <TextBlock Text="古人刻印，是为了让一件东西离开自己手里之后仍然算数：盖下去，就是确认——这话我替你担着。" TextWrapping="Wrap" FontSize="12.5" LineHeight="21" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="翻译是同一件事。原文在彼岸，译文在你这岸，中间必须有人落印；落下的那一刻，意思才算数。" TextWrapping="Wrap" FontSize="12.5" LineHeight="21" Margin="0,5,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="译文落印，一字定音" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Grid>
                        </StackPanel>

                        <!-- 右列：快捷动作 / 引擎 / 最近落印（设计稿 .wb-side）-->
                        <StackPanel Grid.Column="2">
                            <!-- 快捷动作：快捷键取用户真实热键设置（不是写死的示例值）-->
                            <StackPanel Margin="0,0,0,20">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource GroupDiamond}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="1" Text="快捷动作" Style="{StaticResource GroupTitle}"/>
                                    <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0"/>
                                </Grid>
                                <UniformGrid Columns="2" Rows="2">
                                    <Border Style="{StaticResource QuickAction}" Margin="0,0,8,8">
                                        <StackPanel>
                                            <Viewbox Width="17" Height="17" HorizontalAlignment="Left">
                                                <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Capture}"/>
                                            </Viewbox>
                                            <TextBlock Text="截图翻译" FontSize="12.5" Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <TextBlock Text="{Binding DataContext.HotkeyCaptureText, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuickAction}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Viewbox Width="17" Height="17" HorizontalAlignment="Left">
                                                <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.SelectCursor}"/>
                                            </Viewbox>
                                            <TextBlock Text="划词翻译" FontSize="12.5" Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <TextBlock Text="{Binding DataContext.HotkeySelectText, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuickAction}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <Viewbox Width="17" Height="17" HorizontalAlignment="Left">
                                                <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Translate}"/>
                                            </Viewbox>
                                            <TextBlock Text="输入翻译" FontSize="12.5" Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <TextBlock Text="{Binding DataContext.HotkeyInputText, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource QuickAction}">
                                        <StackPanel>
                                            <Viewbox Width="17" Height="17" HorizontalAlignment="Left">
                                                <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Swap}"/>
                                            </Viewbox>
                                            <TextBlock Text="原位替换" FontSize="12.5" Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <TextBlock Text="{Binding DataContext.HotkeyReplaceText, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- 引擎：真实引擎清单与在线状态（不再用设备卡片）-->
                            <StackPanel Margin="0,0,0,20">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource GroupDiamond}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="1" Text="引擎" Style="{StaticResource GroupTitle}"/>
                                    <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0"/>
                                    <!-- 降级开关是真实设置，不是装饰文案 -->
                                    <TextBlock Grid.Column="3" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="9,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="自动降级已开"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.EnableEngineFallback, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="Text" Value="自动降级已关"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Brand.Radius.Seal}" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding DataContext.WorkbenchEngineRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- .wb-li：名称 / 在线标 / 延迟 -->
                                                <Border Padding="14,9" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,9,0"/>
                                                        <Border Grid.Column="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding LatencyText}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- 最近落印：原文与译文左右并排（设计稿 .wb-rec）-->
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource GroupDiamond}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="1" Text="最近落印" Style="{StaticResource GroupTitle}"/>
                                    <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="全部进印谱 →" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                </Grid>
                                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Brand.Radius.Seal}" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding DataContext.WorkbenchRecentRows, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Record.SourceSummary}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Record.TranslatedSummary}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 通用（设计稿 §01） ==================== -->
        <TabItem Header="通用" Tag="{StaticResource Glyph.General}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,26,32,44">
                <StackPanel>
                    <Grid Style="{StaticResource SectionHead}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 方菱形落在书脊线上（内容起点左移 19px 进装订缝），与骑缝线同轴 -->
                        <Border Width="12" Height="12" Style="{StaticResource Diamond}" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0"><TextBlock Text="01" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/></Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock Text="通用" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="GENERAL" Style="{StaticResource SectionEyebrow}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="外观、常驻方式与隐私边界。所有开关改动即时生效，无需重启。" Style="{StaticResource SectionDescription}"/>
                    </Grid>

                    <!-- 分组顺序照设计稿：外观 → 常驻 → 隐私 → 场景档案 -->
                    <ContentControl Content="外观" Style="{StaticResource GroupHeadText}"/>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="主题" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="纸为浅色、墨为深色" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <!-- 四枚写死而不是绑 ThemeOptions：分段控件需要「每枚自己的参数」，
                                         ItemsControl 的 ConverterParameter 绑不上（非依赖属性），就写死这四档 -->
                                    <Border Grid.Column="1" Style="{StaticResource Seg}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Seg.Btn}" Content="按时间" GroupName="ThemeSeg"
                                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource ValueEquals}, ConverterParameter=auto}"/>
                                            <RadioButton Style="{StaticResource Seg.Btn}" Content="跟随系统" GroupName="ThemeSeg"
                                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource ValueEquals}, ConverterParameter=system}"/>
                                            <RadioButton Style="{StaticResource Seg.Btn}" Content="纸" GroupName="ThemeSeg"
                                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource ValueEquals}, ConverterParameter=light}"/>
                                            <RadioButton Style="{StaticResource Seg.Btn}" Content="墨" GroupName="ThemeSeg"
                                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource ValueEquals}, ConverterParameter=dark}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- 纸的时段：只有「按时间」档才现身（见 IsThemeAuto）。
                                 右侧两个下拉就是时段本身，左侧行说明直接报出此刻在哪一段、下个切换点。
                                 两枚下拉的候选各取半段（0~22 / 1~23），保证「起 < 止」天然成立。 -->
                            <Border Style="{StaticResource SheetRow}"
                                    Visibility="{Binding IsThemeAuto, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="纸的时段" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="{Binding ThemeAutoStatus}" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox Width="84" ItemsSource="{Binding PaperFromHourOptions}"
                                                  SelectedValue="{Binding ThemePaperFromHour}" SelectedValuePath="Hour"
                                                  DisplayMemberPath="Display" ToolTip="这段用纸（浅色）"/>
                                        <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        <ComboBox Width="84" ItemsSource="{Binding PaperToHourOptions}"
                                                  SelectedValue="{Binding ThemePaperToHour}" SelectedValuePath="Hour"
                                                  DisplayMemberPath="Display" ToolTip="到点转墨（深色）"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="托盘气泡" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="气泡提示异常与开机自启，不弹窗打断" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding ShowStartBalloon}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="操作确认音效" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="截图识别等关键动作成功后播放一次系统提示音；默认关闭" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding FeedbackSoundEnabled}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 无话可说时整行收起：否则「外观」与「常驻」之间会多出一整行空白，
                         和「常驻」「隐私」之间那种标准组间距对不上 -->
                    <TextBlock Text="{Binding GeneralMessage}" Foreground="{DynamicResource Brush.Error}"
                               TextWrapping="Wrap" Margin="2,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GeneralMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ContentControl Content="常驻" Style="{StaticResource GroupHeadText}" Margin="10,20,0,10"/>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="开机自启" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="以 --minimized 启动，仅驻托盘不占窗口" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding AutoStartEnabled}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="启动动画" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="手动启动时播一遍「启印」落印，点一下或 Esc 可跳过" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding LaunchRevealEnabled}"/>
                                </Grid>
                            </Border>

                            <!-- FR-026：小窗尺寸（默认宽高 + 按内容自适应，14.2.2 / 14.7） -->
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="小窗默认尺寸" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="每次呼出都从这里起算，拖拽边缘只影响本次；宽 320~900，高 240~900" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="92" Height="32" Padding="10,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                 Text="{Binding QuickWindowDefaultWidth}"
                                                 ToolTip="默认宽度（DIP）：320~900，超出会被夹取"/>
                                        <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                        <TextBox Width="92" Height="32" Padding="10,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                 Text="{Binding QuickWindowDefaultHeight}"
                                                 ToolTip="默认高度（DIP）：240~900，超出会被夹取"/>
                                        <Button Content="恢复推荐" Style="{StaticResource Button.Outline}" Padding="12,0" Height="32" Margin="8,0,0,0"
                                                Command="{Binding RestoreRecommendedDefaultSizeCommand}" ToolTip="把默认宽高重置为设计稿推荐的小窗尺寸"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SheetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="按内容自适应" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="译文变长时窗口长高，只增不减；宽度最多加宽到 640" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding QuickWindowAutoSize}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- P0 批 1 / spec §2：隐私模式（本地留痕全关，翻译请求本身仍会发送） -->
                    <ContentControl Content="隐私" Style="{StaticResource GroupHeadText}" Margin="10,20,0,10"/>
                    <Border Style="{StaticResource Sheet}">
                        <Border Style="{StaticResource SheetRowLast}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="隐私模式" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="不记印谱、暂停剪贴板监听、不落日志；翻译请求本身仍会发出（否则无法翻译）。生词本收藏不受影响" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding PrivacyMode}"/>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- FR-037（P0 批 2 / spec §3.4）+ FR-054：场景档案——内置档一键切、当前设置存为自定义档 -->
                    <ContentControl Content="场景档案" Style="{StaticResource GroupHeadText}" Margin="10,20,0,10"/>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="当前档案" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="档案是对若干设置键的稀疏覆盖，未指定的项不动；热键 Alt+P 循环切换" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" MaxWidth="430" HorizontalAlignment="Right">
                                        <ItemsControl ItemsSource="{Binding BuiltinProfileRows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource TagButton}" Content="{Binding Name}" Margin="0,0,6,6"
                                                            ToolTip="点击切到这一档"
                                                            Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Name}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="自定义档案" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="把当前设置存成一档，最多 10 个；点标签切换，点 × 删除" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <WrapPanel HorizontalAlignment="Right" MaxWidth="430">
                                            <ItemsControl ItemsSource="{Binding ProfileRows}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                                                            <Button Style="{StaticResource TagButton}" Content="{Binding Name}"
                                                                    ToolTip="点击切到这一档"
                                                                    Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Name}"/>
                                                            <Button Style="{StaticResource TagDeleteButton}" Content="×"
                                                                    ToolTip="删除该档案"
                                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Name}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                            <TextBox Width="150" Height="32" VerticalContentAlignment="Center"
                                                     Padding="12,0"
                                                     Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="档案名：≤20 字，不能与现有档案重名，最多 10 个"/>
                                            <Button Content="存为档案" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0" Margin="8,0,0,0"
                                                    Command="{Binding SaveCurrentAsProfileCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- FR-059：上手卡只看一次，改了热键后还得有地方再看 -->
                            <Border Style="{StaticResource SheetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="再看一次首次引导" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="重新跑一遍引擎、热键与能力自检" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="重新播放" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0"
                                            VerticalAlignment="Center" Command="{Binding ShowOnboardingCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- 只在有真话要说（保存失败等）时占位：空闲时整行收起，下方内容自然上移 -->
                    <TextBlock Text="{Binding ProfileStatusText}" TextWrapping="Wrap" MaxWidth="460"
                               HorizontalAlignment="Left" TextAlignment="Left" Margin="2,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfileStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ContentControl Content="更多功能" Style="{StaticResource GroupHeadText}" Margin="10,20,0,10"/>
                    <Border Style="{StaticResource Sheet}">
                        <Border Style="{StaticResource SheetRowLast}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="高级工具与维护" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="更新备份、诊断、术语表和进阶能力。展开后左侧导航会增加对应入口。" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding AdvancedSettingsToggleText}"
                                        Style="{StaticResource Button.Outline}" Height="32" Padding="12,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleAdvancedSettingsCommand}"/>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Doctor：热键、OCR、代理、本地写入与更新通道的集中诊断 -->
        <TabItem Header="诊断" Tag="{StaticResource Glyph.Doctor}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,26,32,44">
                <StackPanel>
                    <Grid Style="{StaticResource SectionHead}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="12" Height="12" Style="{StaticResource Diamond}" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0"><TextBlock Text="03" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/></Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock Text="诊断" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="DOCTOR" Style="{StaticResource SectionEyebrow}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="一次跑完全部检查，报告脱敏，不含密钥、原文与译文。" Style="{StaticResource SectionDescription}"/>
                    </Grid>
                    <!-- 自检结果（对齐 design-v4/inkseal-ui.html §03 诊断）：一次跑完的逐项清单，
                         行 = 检查项 + 状态标签 + 等宽证据；不再一项一张卡（旧版观感来源）。 -->
                    <Grid Style="{StaticResource GroupHead}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="自检结果" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                        <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding DoctorSummary}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Height="3" Margin="0,0,0,10" IsIndeterminate="True"
                                 Visibility="{Binding DoctorBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <!-- 自检清单（设计稿 .prog-list）：整块只有一圈外框，行与行之间是一条发丝线，
                         末行由 IsLast 去掉底线，避免与外框重叠成两像素。
                         清单在构造时就按固定检查项铺满（「待检查」），不等跑完才出现。 -->
                    <Border Style="{StaticResource Sheet}">
                        <ItemsControl ItemsSource="{Binding DoctorResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource ProgressRow}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource ProgressRowTitle}"/>
                                            <Border Grid.Column="1" Margin="12,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="Passed">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="Warning">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningContainer}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="Failed">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Error}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Tag.Text}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Margin="12,0,0,0" MaxWidth="360"
                                                       Text="{Binding Detail}" Style="{StaticResource ProgressEvidence}"
                                                       ToolTip="{Binding Detail}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding RunDoctorCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Line.On}" Data="{StaticResource Glyph.Update}"/>
                                    </Viewbox>
                                    <TextBlock Text="重新诊断" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                    Command="{Binding ExportDoctorReportCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Line.Ink}" Data="{StaticResource Glyph.Export}"/>
                                    </Viewbox>
                                    <TextBlock Text="导出脱敏报告" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                    Command="{Binding CopyDoctorReportCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Line.Ink}" Data="{StaticResource Glyph.Copy}"/>
                                    </Viewbox>
                                    <TextBlock Text="复制报告" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Hint}"
                                   Text="{Binding DoctorIssueCount, StringFormat=已发现 {0} 项需要处理}"
                                   Visibility="{Binding DoctorHasIssues, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                    <!-- 同理：空态不占位，只在检查中 / 有结果时出现 -->
                    <TextBlock Text="{Binding DoctorMessage}" TextWrapping="Wrap" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DoctorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 修复入口：只列能就地修的问题，没有可修项时整组隐藏 -->
                    <ContentControl Content="修复入口" Style="{StaticResource GroupHeadText}" Margin="10,22,0,10"
                                    Visibility="{Binding DoctorHasActions, Converter={StaticResource BoolToVisibility}}"/>
                    <Border Style="{StaticResource Sheet}"
                            Visibility="{Binding DoctorHasActions, Converter={StaticResource BoolToVisibility}}">
