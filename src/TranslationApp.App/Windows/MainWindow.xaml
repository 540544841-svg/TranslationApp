                                                    Command="{Binding ResetHotkeyCommand}" CommandParameter="Profile"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 无键盘触发：默认关，隐私模式下不安装钩子 -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="无键盘触发" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="默认关闭，隐私模式下不安装钩子" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <!-- FR-036（P0 批 2 / spec §2.3）：悬停取词——默认关，隐私模式下钩子绝不安装 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="悬停取词" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="选中文字（拖选或双击选词）才浮出印标，点一下即译；需要常驻鼠标钩子，游戏 / 远程桌面场景可随时关闭" Style="{StaticResource RowDesc}"/>
                                            <TextBlock Text="隐私模式开启中，鼠标钩子未启用" Foreground="{DynamicResource Brush.Warning}"
                                                       FontSize="{StaticResource FontSize.Small}" Margin="0,4,0,0"
                                                       Visibility="{Binding HoverLockedByPrivacy, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding HoverSelectEnabled}"/>
                                    </Grid>
                                </Border>
                                <!-- FR-038（P0 批 3 / spec §1）：双击修饰键划词——默认关，隐私模式不装键盘钩子 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="双击修饰键" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="250ms 内双击即翻译当前选中文本；按住期间混按其他键作废，需要常驻键盘钩子" Style="{StaticResource RowDesc}"/>
                                            <TextBlock Text="隐私模式开启中，键盘钩子未启用" Foreground="{DynamicResource Brush.Warning}"
                                                       FontSize="{StaticResource FontSize.Small}" Margin="0,4,0,0"
                                                       Visibility="{Binding DoubleTapLockedByPrivacy, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Width="86" Margin="0,0,10,0" ItemsSource="{Binding DoubleTapKeyOptions}"
                                                      SelectedValue="{Binding DoubleTapKey}" SelectedValuePath="Value"
                                                      DisplayMemberPath="Display" ToolTip="双击哪个修饰键"/>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DoubleTapTranslateEnabled}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- FR-039（P0 批 3 / spec §2）：鼠标侧键映射——只观察不拦截，前进/后退照常发生 -->
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="鼠标侧键" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="只观察不拦截，浏览器的前进 / 后退照常工作，介意请勿开启" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Tag.Line}">
                                                <TextBlock Text="X1 划词" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            </Border>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="8,0,14,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding MouseSideButtonSelect}"/>
                                            <Border Style="{StaticResource Tag.Line}">
                                                <TextBlock Text="X2 截图" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            </Border>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding MouseSideButtonCapture}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 替换行为：仅在开启原位替换后可改 -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="替换行为" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}" IsEnabled="{Binding ReplaceSelectionEnabled}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="替换后写入翻译历史" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="关闭后仍显示本次结果，但不进入历史与 TM；隐私模式始终不写入" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding ReplaceWritesHistory}"/>
