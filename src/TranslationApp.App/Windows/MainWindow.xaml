<Window x:Class="TranslationApp.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TranslationApp.Controls"
        Title="速译 · 设置" Width="720" Height="520"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.App}" FontSize="{StaticResource FontSize.Body}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- FR-024 引擎页：按字段类型 / 状态显隐输入控件与提示条 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <!--
      FR-009：左侧导航式设置窗口（对齐 Windows 11 设置 / macOS 系统设置的导航习惯），
      配置即时保存（无「确定」按钮）；窗口关闭 = 隐藏（托盘常驻）。
      每个 TabItem 的 Tag 提供导航图标字形，由 Themes/Controls.xaml 的 NavItem 模板渲染。
    -->
    <TabControl x:Name="NavTabs" Style="{StaticResource TabControl.Nav}" ItemContainerStyle="{StaticResource NavItem}" Margin="0"
                SelectionChanged="OnNavSelectionChanged">

        <!-- ==================== 通用 ==================== -->
        <TabItem Header="通用" Tag="&#xE713;">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                <StackPanel>
                    <TextBlock Text="启动与常驻" Style="{StaticResource Text.SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="登录 Windows 后自动在托盘常驻，不弹出窗口"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding AutoStartEnabled}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="启动时显示气泡提示" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="启动完成后在托盘弹出一次使用提示"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowStartBalloon}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <!-- P0 批 1 / spec §2：隐私模式（本地留痕全关，翻译请求本身仍会发送） -->
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                    <TextBlock Text="隐私模式" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="开启后不写翻译历史、暂停剪贴板监听、日志不落盘；翻译请求本身仍会发送（否则无法翻译）。生词本收藏不受影响"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding PrivacyMode}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding GeneralMessage}" Foreground="{DynamicResource Brush.Error}"
                               FontSize="{StaticResource FontSize.Small}" TextWrapping="Wrap" Margin="2,10,0,0"/>

                    <TextBlock Text="外观" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="主题" FontSize="{StaticResource FontSize.Body}"/>
                                <TextBlock Text="深色模式会同时适配窗口标题栏"
                                           Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Width="130" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      ItemsSource="{Binding ThemeOptions}"
                                      SelectedValue="{Binding SelectedTheme}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display"/>
                        </Grid>
                    </Border>

                    <!-- FR-026：小窗尺寸卡片，紧跟在「主题」之后（默认宽高 + 按内容自适应，14.2.2 / 14.7） -->
                    <TextBlock Text="小窗尺寸" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="默认宽度 / 默认高度" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="每次呼出都从这个尺寸起算；宽 320~900，高 240~900"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBox Width="76" Text="{Binding QuickWindowDefaultWidth}"
                                             ToolTip="默认宽度（DIP）：320~900，超出会被夹取"/>
                                    <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBox Width="76" Text="{Binding QuickWindowDefaultHeight}"
                                             ToolTip="默认高度（DIP）：240~900，超出会被夹取"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="按内容自适应" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="高度按内容增长；宽度按内容加宽，最多加宽到 640"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding QuickWindowAutoSize}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="恢复推荐默认值" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="把默认宽高重置为 420 × 320"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Content="恢复推荐默认值" Style="{StaticResource Button.Outline}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding RestoreRecommendedDefaultSizeCommand}"/>
                            </Grid>

                            <TextBlock Text="{Binding QuickWindowSizeMessage}" TextWrapping="Wrap" MaxWidth="460"
                                       Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- FR-036（P0 批 2 / spec §2.3）：悬停取词——默认关，隐私模式下钩子绝不安装 -->
                    <TextBlock Text="悬停取词" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                <TextBlock Text="拖拽选择后浮出翻译标" FontSize="{StaticResource FontSize.Body}"/>
                                <TextBlock Text="选中文字后光标旁出现小图标，点击才翻译（与划词热键同一条取词链路）；需要常驻鼠标钩子，游戏 / 远程桌面场景可随时关闭本开关"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="隐私模式开启中，鼠标钩子未启用" Foreground="{DynamicResource Brush.Warning}"
                                           FontSize="{StaticResource FontSize.Small}" Margin="0,4,0,0"
                                           Visibility="{Binding HoverLockedByPrivacy, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding HoverSelectEnabled}"/>
                        </Grid>
                    </Border>

                    <!-- FR-038（P0 批 3 / spec §1）：双击修饰键划词——默认关，隐私模式不装键盘钩子 -->
                    <TextBlock Text="双击修饰键" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                    <TextBlock Text="双击 Alt 划词翻译" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="快速连按两下修饰键即翻译当前选中文本（250ms 内完成、按住期间混按其他键不算）；需要常驻键盘钩子，可随时关闭，隐私模式下绝不启用"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="隐私模式开启中，键盘钩子未启用" Foreground="{DynamicResource Brush.Warning}"
                                               FontSize="{StaticResource FontSize.Small}" Margin="0,4,0,0"
                                               Visibility="{Binding DoubleTapLockedByPrivacy, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox Width="86" Margin="0,0,10,0" ItemsSource="{Binding DoubleTapKeyOptions}"
                                              SelectedValue="{Binding DoubleTapKey}" SelectedValuePath="Value"
                                              DisplayMemberPath="Display" ToolTip="双击哪个修饰键"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DoubleTapTranslateEnabled}"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Hairline}" Margin="0,10"/>

                            <!-- FR-039（P0 批 3 / spec §2）：鼠标侧键映射——只观察不拦截，前进/后退照常发生 -->
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                    <TextBlock Text="鼠标侧键映射" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="X1（后退键）= 划词翻译，X2（前进键）= 截图翻译；本程序只观察不拦截，浏览器的前进 / 后退仍照常发生，介意请勿开启"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="X1 划词" Width="88" VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSize.Small}"/>
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding MouseSideButtonSelect}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="X2 截图" Width="88" VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSize.Small}"/>
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding MouseSideButtonCapture}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- FR-037（P0 批 2 / spec §3.4）：场景档案——内置阅读/隐私两档 + 自定义快照 -->
                    <TextBlock Text="场景档案" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ProfileStatusText}" FontSize="{StaticResource FontSize.Body}"/>
                            <TextBlock Text="把引擎、语言、清洗、术语、隐私与监听打包成一档：热键 Alt+P 或托盘「场景档案」一键循环切换"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="切到「阅读」" Style="{StaticResource Button.Outline}"
                                        Command="{Binding ApplyProfileCommand}" CommandParameter="阅读"/>
                                <Button Content="切到「隐私」" Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                        Command="{Binding ApplyProfileCommand}" CommandParameter="隐私"/>
                                <Button Content="回到「标准」" Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                        Command="{Binding ApplyProfileCommand}" CommandParameter="标准"/>
                            </StackPanel>
                            <Border Style="{StaticResource Hairline}" Margin="0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="180" VerticalContentAlignment="Center"
                                         Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="档案名：≤20 字，不能与现有档案重名，最多 10 个"/>
                                <Button Content="把当前设置存为档案" Style="{StaticResource Button.Outline}"
                                        Margin="8,0,0,0" Command="{Binding SaveCurrentAsProfileCommand}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ProfileRows}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSize.Small}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="应用" Style="{StaticResource Button.Outline}" Padding="10,4"
                                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"/>
                                                <Button Content="删除" Style="{StaticResource Button.Outline}" Padding="10,4"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 热键 ==================== -->
        <TabItem Header="热键" Tag="&#xE765;">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                <StackPanel>
                    <TextBlock Text="输入翻译" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Text="按下热键后在鼠标处弹出小窗，可直接输入文字翻译"
                               Style="{StaticResource Text.Caption}" Margin="0,4,0,8"/>
                    <controls:HotkeyBox Text="{Binding HotkeyInputText}" IsInvalid="{Binding HotkeyInputInvalid}"
                                        Width="260" HorizontalAlignment="Left"/>

                    <TextBlock Text="划词翻译" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <TextBlock Text="先在任意应用中选中文字，再按热键自动取词并翻译"
                               Style="{StaticResource Text.Caption}" Margin="0,4,0,8"/>
                    <controls:HotkeyBox Text="{Binding HotkeySelectText}" IsInvalid="{Binding HotkeySelectInvalid}"
                                        Width="260" HorizontalAlignment="Left"/>

                    <TextBlock Text="截图翻译" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <TextBlock Text="冻结鼠标所在屏幕，拖拽框选区域后自动识别文字并翻译"
                               Style="{StaticResource Text.Caption}" Margin="0,4,0,8"/>
                    <controls:HotkeyBox Text="{Binding HotkeyCaptureText}" IsInvalid="{Binding HotkeyCaptureInvalid}"
                                        Width="260" HorizontalAlignment="Left"/>

                    <!-- FR-037（P0 批 2）：场景档案循环切换热键 -->
                    <TextBlock Text="场景档案切换" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <TextBlock Text="在 标准 → 阅读 → 隐私 → 自定义档案 之间循环切换，每次切换弹一次托盘提示"
                               Style="{StaticResource Text.Caption}" Margin="0,4,0,8"/>
                    <controls:HotkeyBox Text="{Binding HotkeyProfileText}" IsInvalid="{Binding HotkeyProfileInvalid}"
                                        Width="260" HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding HotkeyMessage}" Foreground="{DynamicResource Brush.Error}"
                               FontSize="{StaticResource FontSize.Small}" TextWrapping="Wrap" Margin="2,10,0,0"/>
                    <Button Content="恢复默认热键" Style="{StaticResource Button.Outline}"
                            HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding ResetHotkeysCommand}"/>

                    <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Info}" FontFamily="{StaticResource Font.Icon}"
                                       FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <TextBlock Style="{StaticResource Text.Hint}" MaxWidth="420"
                                       Text="点击录键框后直接按下组合键即可修改（支持 Ctrl / Alt / Shift / Win 加字母、数字或 F1~F12）。若热键已被其他程序占用会标红并保留原热键。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 翻译 ==================== -->
        <TabItem Header="翻译" Tag="&#xE775;">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                <StackPanel>
                    <TextBlock Text="翻译引擎" Style="{StaticResource Text.SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="当前引擎" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="切换后立即生效，无需重启"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ItemsSource="{Binding EngineOptions}"
                                          SelectedValue="{Binding SelectedEngine}"
                                          SelectedValuePath="Id" DisplayMemberPath="Display">
                                    <!-- FR-024：未配置 Key 的引擎显示「（未配置）」且不可选 -->
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem.Modern}">
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource Hairline}"/>
                            <TextBlock Style="{StaticResource Text.Hint}"
                                       Text="Bing 与 Google 为非官方接口，无需配置即可使用；Bing 在国内网络可直连，推荐默认使用。官方引擎（腾讯 / 百度 / Azure / DeepL）与 AI 翻译需在「引擎」页填入 API Key 后才能选择。"/>
                            <TextBlock Text="{Binding EngineMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{DynamicResource Brush.Warning}"/>

                            <!-- FR-028：引擎失败自动降级（与引擎选择同卡片，语义相邻，14.7） -->
                            <Border Style="{StaticResource Hairline}"/>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="引擎失败时自动降级" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="首选引擎不可用时自动改用备用引擎（只降一级）"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding EnableEngineFallback}"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="备用引擎" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="默认 Bing（非官方）：零配置、国内可直连"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsEnabled="{Binding EnableEngineFallback}"
                                          ItemsSource="{Binding EngineOptions}"
                                          SelectedValue="{Binding SelectedFallbackEngine}"
                                          SelectedValuePath="Id" DisplayMemberPath="Display">
                                    <!-- 与「当前引擎」同一套规则：未配置 Key 的引擎标「（未配置）」且不可选 -->
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem.Modern}">
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{Binding FallbackMessage}" TextWrapping="Wrap" MaxWidth="460"
                                       Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="语言" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="默认目标语言" FontSize="{StaticResource FontSize.Body}"/>
                                <TextBlock Text="小窗内也可随时切换，修改会被记住"
                                           Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      ItemsSource="{Binding TargetOptions}"
                                      SelectedValue="{Binding TargetLanguage}"
                                      SelectedValuePath="Code" DisplayMemberPath="Display"/>
                        </Grid>
                    </Border>

                    <!-- P0 批 1 / spec §3.2：划词与剪贴板文本的阅读清洗 -->
                    <TextBlock Text="文本清洗" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                <TextBlock Text="合并复制文本的硬换行" FontSize="{StaticResource FontSize.Body}"/>
                                <TextBlock Text="修复 PDF / 论文复制时的断行与页眉噪声，仅作用于划词与剪贴板自动翻译；手动输入不受影响"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding CleanClipboardText}"/>
                        </Grid>
                    </Border>

                    <!-- FR-040（P0 批 3 / spec §3）：粘贴即译——输入框为空时 Ctrl+V 直接翻译剪贴板 -->
                    <TextBlock Text="粘贴即译" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                <TextBlock Text="小窗内 Ctrl+V 直接翻译剪贴板" FontSize="{StaticResource FontSize.Body}"/>
                                <TextBlock Text="输入框为空时按 Ctrl+V 不再粘贴，直接取剪贴板文本走完整链路（含阅读清洗）；输入框已有内容时仍是普通粘贴"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding PasteTranslateEnabled}"/>
                        </Grid>
                    </Border>

                    <!-- FR-045（P0 批 4 / spec §3）：TM 相似句回填 -->
                    <TextBlock Text="翻译记忆" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                <TextBlock Text="近似句复用历史译文" FontSize="{StaticResource FontSize.Body}"/>
                                <TextBlock Text="翻译前先查历史：与原句相似度 ≥92% 时直接回填并标注「来自 N 天前的记录」，点「重新机器翻译」可强制重译；隐私模式下没有历史可复用"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding TmReuseEnabled}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="结果对比" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="对比引擎（2~3 个）" FontSize="{StaticResource FontSize.Body}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="在小窗点「对比」时并发请求这些引擎，结果分栏展示；不勾选则自动使用「当前引擎 + 第一个其它已配置引擎」。未配置的引擎不可勾选。"/>
                            <ItemsControl ItemsSource="{Binding CompareEngineOptions}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CheckBox.Modern}" Margin="0,0,0,8"
                                                  Content="{Binding Display}"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsEnabled}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding CompareMessage}" TextWrapping="Wrap" MaxWidth="460"
                                       FontSize="{StaticResource FontSize.Caption}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompareMessageIsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource Hairline}"/>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="对比结果写入历史" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="每个引擎的译文各存一条（引擎字段可区分）；关闭后仅当前引擎的译文入库"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding CompareIncludeInHistory}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="提示" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="2,8,0,0" MaxWidth="440"
                               Text="源语言默认为「自动检测」，由引擎识别后回填。若某引擎在当前网络不可用，翻译时会给出明确提示，可直接切换其他引擎。"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <!-- ==================== 引擎：官方引擎 Key 管理（FR-024 / 13.1.6） ==================== -->
        <TabItem Header="引擎" Tag="&#xE8D7;">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                <StackPanel>
                    <TextBlock Text="翻译引擎" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="2,6,0,0" MaxWidth="460"
                               Text="在此填入各家官方引擎的 API Key。密钥经 Windows DPAPI 加密后落盘，配置文件中没有明文；密钥仅在你本机可解密。填好后到「翻译」页把「当前引擎」切成它即可。"/>

                    <ItemsControl ItemsSource="{Binding EngineCards}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- 卡片头：引擎名 + 配置状态徽标 + 测试连接 -->
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.Body}"
                                                           FontWeight="{StaticResource Weight.Medium}"/>
                                                <Border Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                                <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <Button Content="测试连接" Style="{StaticResource Button.Outline}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    ToolTip="发一次真实翻译请求（hello，英→中）验证 Key"
                                                    Command="{Binding TestCommand}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                                        <!-- P0 批 1 / spec §4.3：近 7 天成败看板（无数据时整行隐藏） -->
                                        <TextBlock Text="{Binding StatsText}" Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibility}}"/>

                                        <!-- 端点不可达提示（13.9：仅在实测不可达时出现） -->
                                        <Border Style="{StaticResource Banner.Warning}" Margin="0,10,0,0"
                                                Visibility="{Binding HasReachabilityWarning, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{StaticResource Icon.Error}" FontFamily="{StaticResource Font.Icon}"
                                                           FontSize="12" Margin="0,1,8,0"
                                                           Foreground="{DynamicResource Brush.Warning}"/>
                                                <TextBlock Text="{Binding ReachabilityWarning}" TextWrapping="Wrap" MaxWidth="400"
                                                           FontSize="{StaticResource FontSize.Small}"
                                                           Foreground="{DynamicResource Brush.Warning}"/>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border Style="{StaticResource Hairline}"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Body}"/>
                                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}"
                                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- 明文标识 -->
                                                            <TextBox Grid.Column="1" VerticalAlignment="Center"
                                                                     Height="{StaticResource Height.Control}"
                                                                     FontSize="{StaticResource FontSize.Small}"
                                                                     Padding="10,0" VerticalContentAlignment="Center"
                                                                     Width="{Binding FieldWidth}"
                                                                     Visibility="{Binding IsPlain, Converter={StaticResource BoolToVisibility}}"
                                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>

                                                            <!-- 密钥：密码框 + 显示/隐藏 -->
                                                            <controls:SecretBox Grid.Column="1" VerticalAlignment="Center"
                                                                                Width="{Binding FieldWidth}"
                                                                                Visibility="{Binding IsSecret, Converter={StaticResource BoolToVisibility}}"
                                                                                Password="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                            <!-- 固定候选（腾讯 Region） -->
                                                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                                                      Width="{Binding FieldWidth}"
                                                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"
                                                                      ItemsSource="{Binding Choices}"
                                                                      SelectedItem="{Binding Value}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- DeepL：端点选择（默认按 Key 后缀自动判定，可人工覆盖） -->
                                        <StackPanel Visibility="{Binding HasFreeEndpointToggle, Converter={StaticResource BoolToVisibility}}">
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="使用免费版端点" FontSize="{StaticResource FontSize.Body}"/>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="默认按 Key 后缀 :fx 自动判定（api-free.deepl.com）；手动切换即固定使用该端点"/>
                                                </StackPanel>
                                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding UseFreeEndpoint}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- AI 引擎：高级选项折叠区（温度 + 自定义 Prompt，13.3.2） -->
                                        <StackPanel Visibility="{Binding HasAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                                                    ToolTip="采样温度与自定义 Prompt"
                                                    Command="{Binding ToggleAdvancedCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{StaticResource Icon.Tune}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="高级选项"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="收起高级选项"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="9" Margin="4,1,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextTertiary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="0"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="180"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Margin="0,8,0,0"
                                                        Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="采样温度" FontSize="{StaticResource FontSize.Body}"/>
                                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Text="越低越稳定，翻译建议 0 ~ 0.5"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Slider Style="{StaticResource Slider.Modern}" Width="150"
                                                                Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                                Value="{Binding Temperature}"
                                                                ToolTip="{Binding Temperature, StringFormat={}{0:0.0#}}"/>
                                                        <TextBlock Width="28" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                                                   FontSize="{StaticResource FontSize.Small}"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   Text="{Binding Temperature, StringFormat={}{0:0.0#}}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Style="{StaticResource Hairline}"/>
                                                <TextBlock Text="自定义 Prompt" FontSize="{StaticResource FontSize.Body}"/>
                                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="留空使用内置 Prompt（只输出译文）；可用 {source} / {target} / {text} 占位符，留空即恢复默认"/>
                                                <TextBox MinHeight="84" MaxHeight="150" Margin="0,8,0,0"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                         FontSize="{StaticResource FontSize.Small}"
                                                         Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding AdvancedMessage}" Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}"/>
                                                    <Button Content="恢复默认" Style="{StaticResource Button.Link}"
                                                            HorizontalAlignment="Right"
                                                            ToolTip="清空自定义 Prompt，回到内置提示"
                                                            Command="{Binding ResetPromptCommand}"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 测试连接结果 -->
                                        <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                   FontSize="{StaticResource FontSize.Small}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="2,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{StaticResource Icon.Info}" FontFamily="{StaticResource Font.Icon}"
                                   FontSize="11" Margin="0,2,8,0"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Hint}" MaxWidth="600"
                                   Text="提示：测试连接会消耗约 5 个字符的额度。腾讯 / 百度 在国内网络可直连；Azure / DeepL 属国外引擎，本机实测可达（2026-09-13），若提示网络不可达请在「高级 → 网络代理」中把作用范围设为「仅国外引擎」并填入代理。"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 历史记录（FR-014） ==================== -->
        <TabItem Header="历史" Tag="&#xE81C;">
            <DockPanel Margin="24,20,24,20">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" Height="{StaticResource Height.Control}">
                            <Grid>
                                <TextBox x:Name="HistorySearchBox" Width="240" Height="28"
                                         BorderThickness="0" Background="Transparent"
                                         Padding="28,0,8,0" VerticalContentAlignment="Center"
                                         Text="{Binding HistoryKeyword, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
                                <TextBlock Text="{StaticResource Icon.Search}" FontFamily="{StaticResource Font.Icon}"
                                           FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                           Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <Button Content="刷新" Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                Command="{Binding RefreshHistoryCommand}"/>
                    </StackPanel>
                    <Button Content="清空历史" Style="{StaticResource Button.Outline}"
                            HorizontalAlignment="Right" Command="{Binding ClearHistoryCommand}"/>
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding HistoryMessage}"
                           Style="{StaticResource Text.Caption}" Margin="2,10,0,0"/>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,10" BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding SourceSummary}"
                                                           TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontSize.Small}"/>
                                                <TextBlock Text="{Binding TranslatedSummary}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontSize="{StaticResource FontSize.Small}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}">
                                                    <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding SourceLanguage, Mode=OneWay}"/>
                                                    <Run Text="→"/>
                                                    <Run Text="{Binding TargetLanguage, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Engine, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                                        ToolTip="复制原文与译文"
                                                        Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{StaticResource Icon.Copy}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                                        ToolTip="删除该条"
                                                        Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{StaticResource Icon.Delete}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                        <!-- 空状态（语言人格：动词句说清下一步）：列表为空时给出引导而非一片空白 -->
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="暂无翻译记录&#x0a;翻译过的内容会自动收进这里（保留最近 5000 条）"
                                   Foreground="{DynamicResource Brush.TextDisabled}"
                                   FontSize="{StaticResource FontSize.Small}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=HistoryList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ==================== 生词本（FR-015） ==================== -->
        <TabItem Header="生词本" Tag="&#xE8F1;">
            <DockPanel Margin="24,20,24,20">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="收藏的词条" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="导出 CSV" Style="{StaticResource Button.Outline}"
                                Command="{Binding ExportVocabularyCsvCommand}"/>
                        <Button Content="导出 Anki (TSV)" Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                Command="{Binding ExportVocabularyTsvCommand}"/>
                        <Button Content="刷新" Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                Command="{Binding RefreshVocabularyCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- FR-035（P0 批 2 / spec §1.4）：Anki 直推卡片——只访问本机 29537，不经代理不上外网 -->
                <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                                <TextBlock Text="Anki 直推" FontSize="{StaticResource FontSize.Body}"/>
                                <TextBlock Text="收藏生词时顺带出卡到桌面版 Anki（需开着 Anki 并安装 AnkiConnect 插件，端口 29537）；只访问本机，不经代理、不上外网。收藏是用户显式动作，隐私模式下仍可推送"
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding AnkiEnabled}"/>
                        </Grid>

                        <Border Style="{StaticResource Hairline}" Margin="0,10"/>

                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="牌组" Width="64" VerticalAlignment="Center"
                                           Style="{StaticResource Text.Caption}"/>
                                <TextBox Width="150" VerticalContentAlignment="Center"
                                         Text="{Binding AnkiDeck, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         ToolTip="Anki 里的牌组名，需完全一致"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="笔记模板" Width="64" VerticalAlignment="Center"
                                           Style="{StaticResource Text.Caption}"/>
                                <TextBox Width="150" VerticalContentAlignment="Center"
                                         Text="{Binding AnkiModel, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         ToolTip="如「基本」，需与 Anki 中模板名一致"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="正面字段" Width="64" VerticalAlignment="Center"
                                           Style="{StaticResource Text.Caption}"/>
                                <TextBox Width="150" VerticalContentAlignment="Center"
                                         Text="{Binding AnkiFrontField, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         ToolTip="放原文的字段名（模板编辑界面可查）"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="背面字段" Width="64" VerticalAlignment="Center"
                                           Style="{StaticResource Text.Caption}"/>
                                <TextBox Width="150" VerticalContentAlignment="Center"
                                         Text="{Binding AnkiBackField, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         ToolTip="放译文的字段名"/>
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AnkiPushOnFavorite}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="收藏时顺带推送" VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontSize="{StaticResource FontSize.Small}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="测试连接" Style="{StaticResource Button.Outline}"
                                        Command="{Binding TestAnkiCommand}"/>
                                <Button Content="全部直推" Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                        Command="{Binding PushAllToAnkiCommand}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding AnkiStatusText}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VocabularyMessage}"
                           Style="{StaticResource Text.Caption}" Margin="2,10,0,0"/>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="VocabularyList" ItemsSource="{Binding VocabularyItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,10" BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSize.Small}"/>
                                                <TextBlock Text="{Binding TranslatedText}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSize.Small}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}">
                                                    <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding LanguagePairDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                    VerticalAlignment="Center" ToolTip="从生词本移除"
                                                    Command="{Binding DataContext.DeleteVocabularyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{StaticResource Icon.Delete}" FontFamily="{StaticResource Font.Icon}"
                                                           FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                        <!-- 空状态：生词本为空时给出「去哪里收藏」的引导 -->
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="还没有收藏的词条&#x0a;翻译时在小窗点 ☆ 即可加入，可导出 CSV / Anki"
                                   Foreground="{DynamicResource Brush.TextDisabled}"
                                   FontSize="{StaticResource FontSize.Small}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=VocabularyList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ==================== 术语表（P0 批 1：译文统一后置替换，spec §1.4） ==================== -->
        <TabItem Header="术语表" Tag="&#xE8C1;">
            <DockPanel Margin="24,20,24,20">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="翻译术语表" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/>
                    <Button Content="添加词条" Style="{StaticResource Button.Outline}" HorizontalAlignment="Right"
                            Command="{Binding AddGlossaryCommand}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Hint}" Margin="2,0,0,10" MaxWidth="520"
                           Text="译文生成后把「源词」统一替换为固定译法，对全部引擎生效（长词优先、英文按词边界匹配）；适合产品名与专有名词。最多 500 条，改动即时保存。"/>

                <!-- FR-037（P0 批 2 / spec §4）：术语表全局开关——关闭时词条保留、替换直通 -->
                <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="启用术语表" FontSize="{StaticResource FontSize.Body}"/>
                        <TextBlock Text="关闭后词条保留但不参与替换（切换场景档案时会联动此开关）"
                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" IsChecked="{Binding GlossaryEnabled}"/>
                </Grid>

                <!-- 术语表 JSON 损坏（手改配置文件）时提示，保存一次即修复 -->
                <Border Style="{StaticResource Banner.Warning}" DockPanel.Dock="Top" Margin="0,0,0,10"
                        Visibility="{Binding GlossaryCorrupted, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="术语表无法读取，已按空表运行；在本页保存一次即可修复"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.Warning}"/>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding GlossaryMessage}"
                           Style="{StaticResource Text.Caption}" Margin="2,10,0,0"/>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GlossaryList" ItemsSource="{Binding GlossaryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,8" BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Height="{StaticResource Height.Control}"
                                                         VerticalContentAlignment="Center" FontSize="{StaticResource FontSize.Small}"
                                                         Text="{Binding Source, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                         ToolTip="译文里出现的源词"/>
                                                <TextBlock Grid.Column="1" Text="→" Margin="10,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                <TextBox Grid.Column="2" Height="{StaticResource Height.Control}"
                                                         VerticalContentAlignment="Center" FontSize="{StaticResource FontSize.Small}"
                                                         Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                         ToolTip="期望的固定译法"/>
                                                <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}"
                                                          Margin="14,0,0,0" VerticalAlignment="Center"
                                                          ToolTip="停用但保留词条"
                                                          IsChecked="{Binding Enabled}"/>
                                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                        Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="删除词条"
                                                        Command="{Binding DataContext.DeleteGlossaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{StaticResource Icon.Delete}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 空状态：与历史/生词本同款引导 -->
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="还没有术语词条&#x0a;把产品名、专有名词的固定译法加进来，所有引擎的译文都会统一"
                                   Foreground="{DynamicResource Brush.TextDisabled}"
                                   FontSize="{StaticResource FontSize.Small}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=GlossaryList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ==================== 高级：剪贴板监听 / 朗读 / 代理（FR-016/017/018） ==================== -->
        <TabItem Header="高级" Tag="&#xE713;">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                <StackPanel>
                    <TextBlock Text="自动化" Style="{StaticResource Text.SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="监听剪贴板并自动翻译" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="复制文本后自动弹出翻译小窗；3 秒内多次复制只处理最后一次"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ClipboardMonitorEnabled}"/>
                            </Grid>
                            <Border Style="{StaticResource Hairline}"/>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="划词后自动朗读原文" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="{Binding TtsHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" IsEnabled="{Binding TtsAvailable}"
                                          IsChecked="{Binding AutoSpeakAfterSelect}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="截图翻译（OCR）" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="2,6,0,0" MaxWidth="460"
                               Text="默认使用 Windows 自带的 OCR 引擎，无需联网下载，也不占用额外体积；可选 PaddleOCR 本地模型（识别更准，尤其斜体与小字），模型已内置、无需联网。可识别的语言由所选引擎决定。"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="截图结果处理方式" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="默认把选区图片钉在屏幕上原位置；需要旧行为（文本填入小窗）时在此切回。选「两者都做」时，点击钉图会让翻译小窗在 200ms 后自动隐藏（与点击小窗外部同一规则）"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Width="210" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          ItemsSource="{Binding OcrOutputModeOptions}"
                                          SelectedValue="{Binding OcrOutputMode}"
                                          SelectedValuePath="Tag" DisplayMemberPath="Display"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="截图后自动翻译" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="关闭时仅把识别文本填入输入框，回车再翻译"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding OcrAutoTranslate}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <!-- FR-027（14.6 / 14.7）：钉图默认显示译文，紧邻「截图后自动翻译」 -->
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="钉图默认显示译文" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="关闭时钉图先显示原文（译文已一并取好，不会再多发请求）；点工具条的切换按钮或按空格即显示译文"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding OcrInPlaceReplace}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="OCR 识别语言" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="「自动」跟随系统语言偏好；显式指定时会作为翻译的源语言"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Width="200" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          ItemsSource="{Binding OcrLanguageOptions}"
                                          SelectedValue="{Binding OcrLanguage}"
                                          SelectedValuePath="Tag" DisplayMemberPath="Display">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Modern}">
                                            <Style.Triggers>
                                                <!-- 语言包缺失：无可选项，直接置灰 -->
                                                <DataTrigger Binding="{Binding OcrUnavailable}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <!-- 指定的语言不在系统可用列表 → 该项标红（13.2.5） -->
                                                <DataTrigger Binding="{Binding OcrLanguageMissing}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <!-- FR-029-1（14.3.12.4）：识别前预处理，归属同一卡片（13.5.1） -->
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="识别前预处理" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="小字号或疑似漏识时自动放大并拉伸对比度后再识别一遍（择优采用），更准但略慢；关闭则仅识别原图"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Width="230" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          ItemsSource="{Binding OcrPreprocessOptions}"
                                          SelectedValue="{Binding OcrPreprocess}"
                                          SelectedValuePath="Tag" DisplayMemberPath="Display"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <!-- FR-030（14.9.2 / 14.9.3）：本地识别引擎，归属同一卡片（13.5.1） -->
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="本地识别引擎" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="默认用 Windows 自带引擎（快）；PaddleOCR 内置本地模型（约 22MB，随程序附带），对斜体、小字、低对比度更准，但单次识别约慢 2~4 倍、程序体积更大；不可用时自动改回系统引擎并提示"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Width="230" VerticalAlignment="Center" HorizontalAlignment="Right"
                                          ItemsSource="{Binding OcrLocalEngineOptions}"
                                          SelectedValue="{Binding OcrLocalEngine}"
                                          SelectedValuePath="Tag" DisplayMemberPath="Display"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <!-- FR-030（14.9.2 / 14.9.3）：paddle 模型会话常驻开关 -->
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="PaddleOCR 模型常驻内存" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="默认关闭：空闲 5 分钟后自动释放模型会话，下次识别需约 0.5 秒重建；开启后保持常驻，识别零加载延迟，但常驻内存增加约 30MB"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding OcrPaddleResident}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="遮罩透明度" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="截图遮罩为固定深色，不随主题变化"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider Style="{StaticResource Slider.Modern}" Width="150"
                                            Minimum="0.2" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding OcrScrimOpacity}"/>
                                    <TextBlock Width="42" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding OcrScrimOpacityDisplay}"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <!-- FR-027（14.6 / 14.7）：钉图缩放步进与工具条自动淡出，追加在同一卡片 -->
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="钉图缩放步进" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="钉图里每格滚轮的等比倍数（1.02~2.0，默认 1.1）；Ctrl+滚轮调透明度，Shift+滚轮为精细缩放"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox Width="76" VerticalAlignment="Center" HorizontalAlignment="Right"
                                         Text="{Binding PinZoomStep}"
                                         ToolTip="等比缩放倍数：1.02~2.0，超出会被夹取"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="钉图工具条自动淡出（已停用）" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="工具条已移到截图下方常驻条带，不再遮挡图片文字，此项不再生效（保留仅为兼容旧配置）"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" IsEnabled="False"
                                          IsChecked="{Binding PinToolbarAutoFade}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <TextBlock Text="{Binding OcrMessage}" TextWrapping="Wrap" MaxWidth="460"
                                       FontSize="{StaticResource FontSize.Caption}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OcrLanguageMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 语言包缺失错误条（13.2.5 / 13.5.1）：仅在系统无 OCR 语言包时出现 -->
                    <Border Style="{StaticResource Banner.Error}" Margin="0,10,0,0"
                            Visibility="{Binding OcrUnavailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Error}" FontFamily="{StaticResource Font.Icon}"
                                       FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource Brush.Error}"/>
                            <TextBlock Text="{Binding OcrMessage}" TextWrapping="Wrap" MaxWidth="400"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{DynamicResource Brush.Error}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="网络代理" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="启用代理" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="用于访问在本地网络不可达的翻译引擎（如 Google）"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" IsChecked="{Binding ProxyEnabled}"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid IsEnabled="{Binding ProxyEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="代理作用范围" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="Bing / 腾讯 / 百度 国内可直连；选「仅国外引擎」只让 Google / Azure / DeepL / AI 走代理"
                                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="230" VerticalAlignment="Center"
                                          ItemsSource="{Binding ProxyModeOptions}"
                                          SelectedValue="{Binding SelectedProxyMode}"
                                          SelectedValuePath="Value" DisplayMemberPath="Display"/>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid IsEnabled="{Binding ProxyEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="代理地址" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="如 127.0.0.1（Clash 默认混合端口 7897）"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Width="104" ItemsSource="{Binding ProxySchemeOptions}"
                                              SelectedValue="{Binding ProxyScheme}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              ToolTip="代理协议：HTTP 或 SOCKS5"/>
                                    <TextBox Width="148" Margin="8,0,0,0"
                                             Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                             ToolTip="代理服务器地址"/>
                                    <TextBox Width="76" Margin="8,0,0,0"
                                             Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                             ToolTip="代理端口"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Hairline}"/>

                            <Grid IsEnabled="{Binding ProxyEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="代理认证（可选）" FontSize="{StaticResource FontSize.Body}"/>
                                    <TextBlock Text="密码以 DPAPI 加密保存，配置文件内无明文"
                                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="120" Text="{Binding ProxyUserName, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                             ToolTip="用户名"/>
                                    <PasswordBox x:Name="ProxyPasswordBox" Width="140" Margin="8,0,0,0"
                                                 Padding="10,0" VerticalContentAlignment="Center"
                                                 FontFamily="{StaticResource Font.App}" FontSize="{StaticResource FontSize.Small}"
                                                 PasswordChanged="OnProxyPasswordChanged"
                                                 ToolTip="密码（加密保存）"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="测试代理连通性" Style="{StaticResource Button.Outline}"
                                Command="{Binding TestProxyCommand}"/>
                        <TextBlock Text="{Binding ProxyMessage}" Style="{StaticResource Text.Hint}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
