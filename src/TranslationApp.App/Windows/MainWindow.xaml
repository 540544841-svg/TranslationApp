                                           FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                           VerticalAlignment="Top" Margin="0,1,8,0"/>
                                <TextBlock Style="{StaticResource Text.Hint}" MaxWidth="420"
                                           Text="点击录键框后直接按下组合键即可修改（支持 Ctrl / Alt / Shift / Win 加字母、数字或 F1~F12）。替换热键即使功能关闭也可提前配置；被占用时会标红并保留原热键。"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="恢复默认热键" Style="{StaticResource Button.Outline}"
                                    VerticalAlignment="Center" Margin="16,0,0,0"
                                    Command="{Binding ResetHotkeysCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 翻译 ==================== -->
        <TabItem Header="翻译" Tag="{StaticResource Glyph.Translate}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,26,32,44">
                <StackPanel>
                    <Grid Style="{StaticResource SectionHead}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="12" Height="12" Style="{StaticResource Diamond}" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0"><TextBlock Text="05" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/></Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock Text="翻译" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="TRANSLATION" Style="{StaticResource SectionEyebrow}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="引擎选择、回填策略与文本前处理。降级永不静默改设置。" Style="{StaticResource SectionDescription}"/>
                    </Grid>
                    <!-- 引擎路由：改完立即生效，降级只降一级、绝不静默改当前设置 -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="引擎路由" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="当前引擎" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="切换后立即生效，无需重启" Style="{StaticResource RowDesc}"/>
                                            <TextBlock Text="{Binding EngineMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       FontSize="{StaticResource FontSize.Small}"
                                                       Foreground="{DynamicResource Brush.Warning}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  ItemsSource="{Binding EngineOptions}"
                                                  SelectedValue="{Binding SelectedEngine}"
                                                  SelectedValuePath="Id" DisplayMemberPath="Display">
                                            <!-- FR-024：未配置 Key 的引擎显示「（未配置）」且不可选 -->
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem.Modern}">
                                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <!-- FR-028：引擎失败自动降级 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="失败自动降级" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="只降一级到备用引擎，绝不自动改当前设置" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding EnableEngineFallback}"/>
                                    </Grid>
                                </Border>
                                <!-- 对比引擎（设计稿 .row）：收起时是一行「胶囊摘要 + 编辑」，
                                     展开后才出现勾选清单与写入历史开关，默认观感与设计稿一致。 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="对比引擎" Style="{StaticResource RowLabel}"/>
                                                <TextBlock Text="勾选后小窗可分栏并排比较" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Tag.Vermilion}">
                                                    <TextBlock Text="{Binding ComparePrimaryTag}" FontSize="11.5"
                                                               Foreground="{DynamicResource Brush.PrimaryText}"/>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding CompareEngineTags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Tag.Line}" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding}" FontSize="11.5"
                                                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                                        Content="编辑" Command="{Binding ToggleCompareEditorCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding CompareEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding CompareEngineOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource CheckBox.Modern}" Margin="0,0,0,8"
                                                                  Content="{Binding Display}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  IsEnabled="{Binding IsEnabled}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding CompareMessage}" TextWrapping="Wrap" MaxWidth="460" Margin="0,2,0,0"
                                                       HorizontalAlignment="Left" TextAlignment="Left"
                                                       FontSize="{StaticResource FontSize.Caption}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CompareMessageIsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="对比结果写入历史" Style="{StaticResource RowLabel}"/>
                                                    <TextBlock Text="每个引擎的译文各存一条（引擎字段可区分）；关闭后仅当前引擎的译文入库" Style="{StaticResource RowDesc}"/>
                                                </StackPanel>
                                                <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                          IsChecked="{Binding CompareIncludeInHistory}"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="备用引擎" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="默认 Bing（非官方）：零配置、国内可直连" Style="{StaticResource RowDesc}"/>
                                            <TextBlock Text="{Binding FallbackMessage}" TextWrapping="Wrap" MaxWidth="460"
                                                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  IsEnabled="{Binding EnableEngineFallback}"
                                                  ItemsSource="{Binding EngineOptions}"
                                                  SelectedValue="{Binding SelectedFallbackEngine}"
                                                  SelectedValuePath="Id" DisplayMemberPath="Display">
                                            <!-- 与「当前引擎」同一套规则：未配置 Key 的引擎标「（未配置）」且不可选 -->
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem.Modern}">
                                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="语言" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="默认目标语言" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="源语言自动检测，小窗内也可随时切换，修改会被记住" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  ItemsSource="{Binding TargetOptions}"
                                                  SelectedValue="{Binding TargetLanguage}"
                                                  SelectedValuePath="Code" DisplayMemberPath="Display"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 译文策略：文本前处理 → 历史回填 → 语境，按翻译管线顺序排列 -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="译文策略" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <!-- P0 批 1 / spec §3.2：划词与剪贴板文本的自动整理换行 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="文本清洗" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="修复 PDF / 论文复制时的断行与页眉噪声，仅作用于划词与剪贴板自动翻译；手动输入不受影响" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding CleanClipboardText}"/>
                                    </Grid>
                                </Border>

                                <!-- FR-045（P0 批 4 / spec §3）：TM 相似句回填 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="印谱回填" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="翻译前先查历史：相似度 ≥92% 时直接回填并标注「来自 N 天前的记录」，可点「重新机器翻译」强制重译；隐私模式下没有历史可复用" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding TmReuseEnabled}"/>
                                    </Grid>
                                </Border>
                                <!-- FR-040（P0 批 3 / spec §3）：粘贴即译——输入框为空时 Ctrl+V 直接翻译剪贴板 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="粘贴即译" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="小窗内输入框为空时按 Ctrl+V 不再粘贴，直接取剪贴板文本走完整链路；输入框已有内容时仍是普通粘贴" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding PasteTranslateEnabled}"/>
                                    </Grid>
                                </Border>

                                <!-- FR-050（批 5 / spec §1）：AI 语境化翻译 -->
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="AI 语境" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="连续翻译时把同语言对 30 分钟内最近一条原文写进系统提示，术语与人称更连贯；只对 AI 引擎生效，隐私模式下不会因此多送任何内容" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding LlmContextEnabled}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- FR-058（批 6 / spec §3）：按前台应用记忆语言对 -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="应用语言对" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="只认前台进程名" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="记住每个应用里用的语言对" Style="{StaticResource RowLabel}"/>
                                                <TextBlock Text="命中规则时只改本次会话的语言（不改全局默认，切个浏览器不会把你的默认语言偷偷换掉）；最多 20 条，不读窗口标题、路径或内容" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center"
                                                      IsChecked="{Binding AppLanguageMemoryEnabled}"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                                                       Text="还没有记住任何应用：开启后在某个程序里改一次目标语言即可。"
                                                       Visibility="{Binding HasNoAppLanguageRules, Converter={StaticResource BoolToVisibility}}"/>
                                            <ItemsControl ItemsSource="{Binding AppLanguageRuleRows}"
                                                          Visibility="{Binding HasAppLanguageRules, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                                       FontSize="{StaticResource FontSize.Small}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                                                            <Button Content="删除" Style="{StaticResource Button.Outline}"
                                                                    Padding="8,2" Height="22" HorizontalAlignment="Right"
                                                                    Command="{Binding DataContext.ForgetAppLanguageRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Process}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="全部清除" Style="{StaticResource Button.Outline}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Visibility="{Binding HasAppLanguageRules, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding ClearAppLanguageRulesCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Info}" FontFamily="{StaticResource Font.Icon}"
                                       FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <TextBlock Style="{StaticResource Text.Hint}" MaxWidth="620"
                                       Text="源语言默认为「自动检测」，由引擎识别后回填。若某引擎在当前网络不可用，翻译时会给出明确提示，可直接切换其他引擎。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 引擎：官方引擎 Key 管理（FR-024 / 13.1.6） ==================== -->
        <TabItem Header="引擎" Tag="{StaticResource Glyph.Engine}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,26,32,44">
                <StackPanel>
                    <StackPanel.Resources>
                        <!-- 引擎页每张印面只定义一次：两组（免密钥 / 官方引擎）共用这同一份模板。 -->
                        <DataTemplate x:Key="EngineCardTemplate">
                                <!-- 等高对齐：UniformGrid 会把同一行的两张印面拉到等高，不靠顶，
                                     短的那张就不留半截空白；底部功能栏用 DockPanel 钉在卡片底部，
                                     两栏的按钮才会落在同一条基线上。 -->
                                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- 同组印面共用一个尺寸组：正文行取最高的那一张，短的
                                                 不再缩回去，底部功能栏因此落在同一条基线上 -->
                                            <RowDefinition Height="Auto" SharedSizeGroup="EngineCardBody"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- 底部功能栏（设计稿 .eng 底部那一行）：左状态、右测试连接 -->
                                        <StackPanel Grid.Row="1">
                                            <Grid Margin="0,12,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Tag.Line}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FooterTagPositive}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FooterTagCaution}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningContainer}"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding FooterTagText}" Style="{StaticResource Tag.Text}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FooterHint}" Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center" Margin="9,0,0,0"
                                                               Visibility="{Binding HasFooterHint, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <Button Content="测试连接" Style="{StaticResource Button.Outline}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        ToolTip="发一次真实翻译请求（hello，英译中）验证 Key"
                                                        Command="{Binding TestCommand}"/>
                                            </Grid>

                                            <!-- 测试连接结果：没有结果时整块收起，否则每张印面底下都会多出一条空行 -->
                                            <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                       FontSize="{StaticResource FontSize.Small}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TestMessage}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0">
                                        <!-- 卡片头：引擎名 + 配置状态徽标 + 测试连接 -->
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.Body}"
                                                           FontWeight="{StaticResource Weight.Medium}"/>
                                                <Border Style="{StaticResource Tag.Vermilion}" Margin="8,0,0,0"
                                                        Visibility="{Binding IsCurrentEngine, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="当前引擎" FontSize="11.5"
                                                               Foreground="{DynamicResource Brush.PrimaryText}"/>
                                                </Border>
                                                <Border Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                                <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                                        <!-- P0 批 1 / spec §4.3：近 7 天成败看板（无数据时整行隐藏） -->
                                        <TextBlock Text="{Binding StatsText}" Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibility}}"/>

                                        <!-- 端点不可达提示（13.9：仅在实测不可达时出现） -->
                                        <Border Style="{StaticResource Banner.Warning}" Margin="0,10,0,0"
                                                Visibility="{Binding HasReachabilityWarning, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{StaticResource Icon.Error}" FontFamily="{StaticResource Font.Icon}"
                                                           FontSize="12" Margin="0,1,8,0"
                                                           Foreground="{DynamicResource Brush.Warning}"/>
                                                <TextBlock Text="{Binding ReachabilityWarning}" TextWrapping="Wrap" MaxWidth="400"
                                                           FontSize="{StaticResource FontSize.Small}"
                                                           Foreground="{DynamicResource Brush.Warning}"/>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border Style="{StaticResource Hairline}"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Body}"/>
                                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}"
                                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- 明文标识 -->
                                                            <TextBox Grid.Column="1" VerticalAlignment="Center"
                                                                     Height="{StaticResource Height.Control}"
                                                                     FontSize="{StaticResource FontSize.Small}"
                                                                     Padding="10,0" VerticalContentAlignment="Center"
                                                                     Width="{Binding FieldWidth}"
                                                                     Visibility="{Binding IsPlain, Converter={StaticResource BoolToVisibility}}"
                                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>

                                                            <!-- 密钥：密码框 + 显示/隐藏 -->
                                                            <controls:SecretBox Grid.Column="1" VerticalAlignment="Center"
                                                                                Width="{Binding FieldWidth}"
                                                                                Visibility="{Binding IsSecret, Converter={StaticResource BoolToVisibility}}"
                                                                                Password="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                            <!-- 固定候选（腾讯 Region） -->
                                                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                                                      Width="{Binding FieldWidth}"
                                                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"
                                                                      ItemsSource="{Binding Choices}"
                                                                      SelectedItem="{Binding Value}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- DeepL：端点选择（默认按 Key 后缀自动判定，可人工覆盖） -->
                                        <StackPanel Visibility="{Binding HasFreeEndpointToggle, Converter={StaticResource BoolToVisibility}}">
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="使用免费版端点" FontSize="{StaticResource FontSize.Body}"/>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="默认按 Key 后缀 :fx 自动判定（api-free.deepl.com）；手动切换即固定使用该端点"/>
                                                </StackPanel>
                                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding UseFreeEndpoint}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- AI 引擎：高级选项折叠区（温度 + 自定义 Prompt，13.3.2） -->
                                        <StackPanel Visibility="{Binding HasAdvancedOptions, Converter={StaticResource BoolToVisibility}}">
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                                                    ToolTip="采样温度与自定义 Prompt"
                                                    Command="{Binding ToggleAdvancedCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{StaticResource Icon.Tune}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="高级选项"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="收起高级选项"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="9" Margin="4,1,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextTertiary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="0"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="180"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Margin="0,8,0,0"
                                                        Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="采样温度" FontSize="{StaticResource FontSize.Body}"/>
                                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Text="越低越稳定，翻译建议 0 ~ 0.5"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Slider Style="{StaticResource Slider.Modern}" Width="150"
                                                                Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                                Value="{Binding Temperature}"
                                                                ToolTip="{Binding Temperature, StringFormat={}{0:0.0#}}"/>
                                                        <TextBlock Width="28" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                                                   FontSize="{StaticResource FontSize.Small}"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   Text="{Binding Temperature, StringFormat={}{0:0.0#}}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Style="{StaticResource Hairline}"/>
                                                <TextBlock Text="自定义 Prompt" FontSize="{StaticResource FontSize.Body}"/>
                                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="留空使用内置 Prompt（只输出译文）；可用 {source} / {target} / {context} / {style} 占位符，正文自动作为用户消息发送"/>
                                                <TextBox MinHeight="84" MaxHeight="150" Margin="0,8,0,0"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                         FontSize="{StaticResource FontSize.Small}"
                                                         Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding AdvancedMessage}" Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}"/>
                                                    <Button Content="恢复默认" Style="{StaticResource Button.Link}"
                                                            HorizontalAlignment="Right"
                                                            ToolTip="清空自定义 Prompt，回到内置提示"
                                                            Command="{Binding ResetPromptCommand}"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                    </StackPanel>
                                    </Grid>
                                </Border>
                        </DataTemplate>
                    </StackPanel.Resources>
                    <Grid Style="{StaticResource SectionHead}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="12" Height="12" Style="{StaticResource Diamond}" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0"><TextBlock Text="06" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/></Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock Text="引擎" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="ENGINES" Style="{StaticResource SectionEyebrow}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="引擎各一张印面；AI 通用接口另有多档供应商与双协议。密钥经 Windows DPAPI 加密落盘，配置文件中没有明文；「测试连接」发一次真实请求。" Style="{StaticResource SectionDescription}"/>
                    </Grid>

                    <Grid Style="{StaticResource GroupHead}" Margin="10,18,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="免密钥" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                        <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="开箱可用" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding KeylessEngineCards}"
                                  ItemTemplate="{StaticResource EngineCardTemplate}"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 上面那组印面自带 14 的下边距，这里只补 8，两组之间的净距才和其他页一致（≈50） -->
                    <Grid Style="{StaticResource GroupHead}" Margin="10,8,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="官方引擎" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                        <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="需填密钥" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding KeyedEngineCards}"
                                  ItemTemplate="{StaticResource EngineCardTemplate}"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- AI 供应商（FR-022）：上面两组是「一引擎一印面」，这里是「一引擎多档位」。
                         胶囊行切换档位，编辑区只编辑被选中的那一档；「设为当前」才真正生效。
                         ContentControl 内容为 null 时整块不渲染，引擎目录里没有 llm 时不占位。 -->
                    <ContentControl Content="{Binding AiProviders}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Style="{StaticResource GroupHead}" Margin="10,8,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="AI 供应商" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                                        <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="多档 · 双协议" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                                        <StackPanel>
                                            <!-- 档位胶囊行：左胶囊、右「设为当前 / 新档 / 删除」 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Providers}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource TagButton}" Content="{Binding ChipLabel}"
                                                                    Margin="0,0,6,6" ToolTip="点开编辑这一档；点「设为当前」才会用它翻译"
                                                                    Command="{Binding DataContext.SelectProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                                    <Button Content="设为当前" Style="{StaticResource Button.Outline}" Height="26" Padding="10,0" Margin="0,0,6,6"
                                                            ToolTip="把这档设为当前供应商，并把当前引擎切到 AI"
                                                            Command="{Binding UseProviderCommand}"/>
                                                    <Button Content="+ 新档" Style="{StaticResource Button.Outline}" Height="26" Padding="10,0" Margin="0,0,6,6"
                                                            ToolTip="新建一档供应商：家里 Ollama、公司网关、云上 API 可以同时留着"
                                                            Command="{Binding AddProviderCommand}"/>
                                                    <Button Content="删除" Style="{StaticResource Button.Outline}" Height="26" Padding="10,0" Margin="0,0,0,6"
                                                            ToolTip="删掉正在编辑的这一档（只剩一档时不可删）"
                                                            Command="{Binding RemoveProviderCommand}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding SelectedHint}" Style="{StaticResource Text.Caption}"
                                                       TextWrapping="Wrap" Margin="0,0,0,2"/>

                                            <!-- 供应商名称 -->
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="供应商名称" FontSize="{StaticResource FontSize.Body}"/>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="只是这一档的名字，随便叫，方便在胶囊行里认出来"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Style="{StaticResource Field.TextBox}" Width="400" Height="32"
                                                         FontSize="{StaticResource FontSize.Small}" VerticalContentAlignment="Center"
                                                         Padding="10,0"
                                                         Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                            </Grid>

                                            <!-- API 请求地址 -->
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="API 请求地址" FontSize="{StaticResource FontSize.Body}"/>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="填根地址或 /v1 均可，请求前自动归一化；换协议不用改地址"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Style="{StaticResource Field.TextBox}" Width="400" Height="32"
                                                         FontSize="{StaticResource FontSize.Small}" VerticalContentAlignment="Center"
                                                         Padding="10,0"
                                                         Text="{Binding Selected.BaseUrl, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                            </Grid>

                                            <!-- 模型名 + 获取模型列表 -->
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
                                                    <TextBlock Text="模型" FontSize="{StaticResource FontSize.Body}"/>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="手填模型名后点「加入列表」，攒成自己的模型列表；也可向接口要一份"/>
                                                    <TextBlock Text="{Binding Selected.ModelFetchMessage}" Style="{StaticResource Text.Caption}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding Selected.HasModelFetchMessage, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                    <!-- 模型框与其他输入框同宽（按钮移到框下，不再挤占输入长度） -->
                                                    <TextBox Style="{StaticResource Field.TextBox}" Width="400" Height="32"
                                                             FontSize="{StaticResource FontSize.Small}" VerticalContentAlignment="Center"
                                                             Padding="10,0"
                                                             Text="{Binding Selected.ModelName, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                        <Button Content="获取模型列表" Style="{StaticResource Button.Outline}"
                                                                Height="28" Padding="10,0"
                                                                ToolTip="向这一档的 GET {base}/v1/models 要一份模型列表"
                                                                Command="{Binding FetchModelsCommand}"/>
                                                        <Button Content="加入列表" Style="{StaticResource Button.Outline}"
                                                                Height="28" Padding="10,0" Margin="8,0,0,0"
                                                                ToolTip="把框里手填的模型名加进自建列表（跨会话保留）"
                                                                Command="{Binding Selected.AddToCustomListCommand}"/>
                                                        <Button Content="清除列表" Style="{StaticResource Button.Outline}"
                                                                Height="28" Padding="10,0" Margin="8,0,0,0"
                                                                ToolTip="清掉接口拉回的候选（自建列表保留）"
                                                                Command="{Binding Selected.ClearFetchedModelsCommand}"/>
                                                    </StackPanel>
                                                    <!-- 下拉项：行尾挂删除 ×。
                                                         容器模板自己带 ×，而不是 ItemTemplate——ItemTemplate 也会被选中项复用，
                                                         那样闭合态里就会多出一个点不动的 ×。 -->
                                                    <ComboBox Margin="0,8,0,0" Width="400"
                                                              ItemsSource="{Binding Selected.ModelOptions}"
                                                              SelectedItem="{Binding Selected.PickedModel}"
                                                              DropDownOpened="OnModelDropDownOpened"
                                                              DropDownClosed="OnModelDropDownClosed"
                                                              Visibility="{Binding Selected.HasModelOptions, Converter={StaticResource BoolToVisibility}}">
                                                        <ComboBox.ItemContainerStyle>
                                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem.Modern}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ComboBoxItem">
                                                                            <Grid>
                                                                                <Border x:Name="Root" Background="Transparent"
                                                                                        CornerRadius="{StaticResource Radius.Chip}"
                                                                                        Margin="3,1" Padding="{TemplateBinding Padding}">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <!-- 自建条目才有 ×（代码里按 CustomModels 点亮） -->
                                                                                            <Border x:Name="RowDelete" Width="20" Height="20" Margin="4,0,0,0"
                                                                                                    CornerRadius="{StaticResource Radius.Chip}"
                                                                                                    Cursor="Hand" Visibility="Collapsed">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border">
                                                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                                                        <Style.Triggers>
                                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                                <Setter Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
                                                                                                            </Trigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock Text="×" FontSize="12"
                                                                                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                            <TextBlock x:Name="Tick" Text="{StaticResource Icon.Check}"
                                                                                                       FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                                                                                       Foreground="{DynamicResource Brush.PrimaryText}"
                                                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                                       Visibility="Collapsed"/>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <!-- 落点插入线：画在哪，松手就落在哪 -->
                                                                                <Border x:Name="DropBefore" Height="2" Margin="-3,1,-3,0" VerticalAlignment="Top"
                                                                                        Background="{DynamicResource Brush.Primary}" CornerRadius="1"
                                                                                        IsHitTestVisible="False" Visibility="Collapsed"/>
                                                                                <Border x:Name="DropAfter" Height="2" Margin="-3,0,-3,1" VerticalAlignment="Bottom"
                                                                                        Background="{DynamicResource Brush.Primary}" CornerRadius="1"
                                                                                        IsHitTestVisible="False" Visibility="Collapsed"/>
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                                                                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ComboBox.ItemContainerStyle>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Wire API -->
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="Wire API" FontSize="{StaticResource FontSize.Body}"/>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="chat 走 /chat/completions；responses 走 /responses"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" Width="400" VerticalAlignment="Center"
                                                          ItemsSource="{Binding WireApis}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Selected.WireApi}"/>
                                            </Grid>

                                            <!-- 鉴权开关 -->
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="需要鉴权" FontSize="{StaticResource FontSize.Body}"/>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="本地 Ollama / vLLM / 内网网关可以关掉，请求就不发 Authorization"/>
                                                </StackPanel>
                                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding Selected.RequiresAuth}"/>
                                            </Grid>

                                            <!-- API Key（关掉鉴权则整行隐藏） -->
                                            <StackPanel Visibility="{Binding Selected.RequiresAuth, Converter={StaticResource BoolToVisibility}}">
                                                <Border Style="{StaticResource Hairline}"/>
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="API Key" FontSize="{StaticResource FontSize.Body}"/>
                                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Text="Windows DPAPI 加密落盘，配置文件里没有明文"/>
                                                    </StackPanel>
                                                    <controls:SecretBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="400"
                                                                        Password="{Binding Selected.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 自定义请求头（折叠） -->
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="自定义请求头" FontSize="{StaticResource FontSize.Body}"/>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Text="JSON 对象，如 {&quot;X-Org&quot;:&quot;team&quot;}；留空不附加"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        ToolTip="展开编辑额外请求头"
                                                        Command="{Binding ToggleHeadersCommand}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="展开"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHeadersExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="收起"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </Grid>
                                            <TextBox Width="400" MinHeight="72" MaxHeight="140" Margin="0,8,0,0" HorizontalAlignment="Right"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                     FontSize="{StaticResource FontSize.Small}"
                                                     Text="{Binding Selected.ExtraHeaders, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                     Visibility="{Binding IsHeadersExpanded, Converter={StaticResource BoolToVisibility}}"/>

                                            <!-- 高级选项：对全部档生效（采样温度 + 自定义 Prompt） -->
                                            <Border Style="{StaticResource Hairline}"/>
                                            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left"
                                                    ToolTip="采样温度与自定义 Prompt（对所有档生效）"
                                                    Command="{Binding ToggleAdvancedCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{StaticResource Icon.Tune}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="高级选项"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="收起高级选项"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Margin="0,8,0,0"
                                                        Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="采样温度" FontSize="{StaticResource FontSize.Body}"/>
                                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Text="越低越稳定，翻译建议 0 ~ 0.5"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Slider Style="{StaticResource Slider.Modern}" Width="150"
                                                                Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                                Value="{Binding Temperature}"
                                                                ToolTip="{Binding Temperature, StringFormat={}{0:0.0#}}"/>
                                                        <TextBlock Width="28" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                                                   FontSize="{StaticResource FontSize.Small}"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   Text="{Binding Temperature, StringFormat={}{0:0.0#}}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Style="{StaticResource Hairline}"/>
                                                <TextBlock Text="自定义 Prompt" FontSize="{StaticResource FontSize.Body}"/>
                                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="留空使用内置 Prompt（只输出译文）；可用 {source} / {target} / {context} / {style} 占位符；对所有档生效"/>
                                                <TextBox MinHeight="84" MaxHeight="150" Margin="0,8,0,0"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                         FontSize="{StaticResource FontSize.Small}"
                                                         Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding AdvancedMessage}" Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}"/>
                                                    <Button Content="恢复默认" Style="{StaticResource Button.Link}" HorizontalAlignment="Right"
                                                            ToolTip="清空自定义 Prompt，回到内置提示"
                                                            Command="{Binding ResetPromptCommand}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 底部功能栏：左状态、右测试连接 -->
                                            <Grid Margin="0,12,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Tag.Line}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FooterTagPositive}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding FooterTagText}" Style="{StaticResource Tag.Text}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FooterHint}" Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                                                </StackPanel>
                                                <Button Content="测试连接" Style="{StaticResource Button.Outline}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        ToolTip="发一次真实翻译请求（hello，英译中）验证当前档；先「设为当前」再测"
                                                        Command="{Binding TestCommand}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                       FontSize="{StaticResource FontSize.Small}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TestMessage}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <Grid Margin="2,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{StaticResource Icon.Info}" FontFamily="{StaticResource Font.Icon}"
                                   FontSize="11" Margin="0,2,8,0"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Hint}" MaxWidth="600"
                                   HorizontalAlignment="Left" TextAlignment="Left"
                                   Text="提示：测试连接会消耗约 5 个字符的额度。腾讯 / 百度 在国内网络可直连；Azure / DeepL 属国外引擎，本机实测可达（2026-09-13），若提示网络不可达请在「高级 → 网络代理」中把作用范围设为「仅国外引擎」并填入代理。"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 印谱（FR-014 / 设计稿 §07） ==================== -->
        <TabItem Header="印谱" Tag="{StaticResource Glyph.History}">
            <DockPanel Margin="20,26,32,44">
                <Grid DockPanel.Dock="Top" Style="{StaticResource SectionHead}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="12" Height="12" Style="{StaticResource Diamond}" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0">
                        <TextBlock Text="07" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                        <TextBlock Text="印谱" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="HISTORY" Style="{StaticResource SectionEyebrow}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="每一次落印都收在这里，最多保留最近 5000 印，与藏印分开清理。" Style="{StaticResource SectionDescription}"/>
                </Grid>

                <!-- 检索：一块印面装下关键字与三枚筛选胶囊，印数落在最右端 -->
                <StackPanel DockPanel.Dock="Top">
                    <ContentControl Content="检索" Style="{StaticResource GroupHeadText}"/>
                    <Border Style="{StaticResource Sheet}" Padding="14,16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="HistorySearchBox" Style="{StaticResource Field.TextBox}"
                                         Height="32" FontSize="13" VerticalContentAlignment="Center"
                                         Padding="10,0"
                                         Text="{Binding HistoryKeyword, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
                                <TextBlock Text="搜索原文或译文" Margin="13,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" FontSize="13"
                                           Foreground="{DynamicResource Brush.TextTertiary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=HistorySearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox Grid.Column="1" Style="{StaticResource ComboBox.Pill}" Margin="10,0,0,0"
                                      ItemsSource="{Binding HistoryEngineOptions}"
                                      SelectedItem="{Binding HistoryEngineFilterLabel}"
                                      ToolTip="按引擎筛选"/>
                            <ComboBox Grid.Column="2" Style="{StaticResource ComboBox.Pill}" Margin="8,0,0,0"
                                      ItemsSource="{Binding HistoryTimeLabels}"
                                      SelectedItem="{Binding HistoryTimeFilterLabel}"
                                      ToolTip="按时间筛选"/>
                            <ComboBox Grid.Column="3" Style="{StaticResource ComboBox.Pill}" Margin="8,0,0,0"
                                      ItemsSource="{Binding HistoryTargetLanguageOptions}"
                                      SelectedItem="{Binding HistoryTargetLanguageFilterLabel}"
                                      ToolTip="按目标语言筛选"/>
                            <CheckBox Grid.Column="4" Style="{StaticResource PillToggle}" Margin="8,0,0,0"
                                      Content="只看固定" IsChecked="{Binding HistoryPinnedOnly}"
                                      ToolTip="只显示已固定（星标）的高频译文"/>
                            <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Margin="8,0,0,0" ToolTip="重新载入印谱"
                                    Command="{Binding RefreshHistoryCommand}">
                                <Viewbox Width="15" Height="15">
                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Refresh}"/>
                                </Viewbox>
                            </Button>
                            <TextBlock Grid.Column="6" Text="{Binding HistoryCountDisplay}" Margin="12,0,2,0"
                                       VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 最近落印：分组开关挂在刻痕右端，不必另占一行 -->
                <Grid DockPanel.Dock="Top" Style="{StaticResource GroupHeadSlot}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="最近落印" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                    <Border Grid.Column="2" Style="{DynamicResource HairlineFill}" Margin="9,0,0,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="9,0,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding HistoryGroupedView}"
                                  ToolTip="相邻 30 分钟内的翻译归为一个会话；搜索或筛选时自动回到平铺列表"/>
                        <TextBlock Text="按会话分组" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"/>
                    </StackPanel>
                </Grid>

                <!-- 计数与三枚动作同占一行：左计数、右动作，下方不再空出一片 -->
                <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock Text="{Binding HistoryMessage}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="导出 CSV" Style="{StaticResource Button.Outline}"
                                Padding="10,0" Height="26" FontSize="11.5"
                                Command="{Binding ExportHistoryCsvCommand}"/>
                        <Button Content="导出 Anki" Style="{StaticResource Button.Outline}" Margin="10,0,0,0"
                                Padding="10,0" Height="26" FontSize="11.5"
                                Command="{Binding ExportHistoryTsvCommand}"/>
                        <Button Content="清空印谱" Style="{StaticResource Button.Outline}" Margin="18,0,0,0"
                                Padding="10,0" Height="26" FontSize="11.5"
                                Foreground="{DynamicResource Brush.Error}"
                                Command="{Binding ClearHistoryCommand}"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Sheet}">
                    <Grid>
                        <ListBox x:Name="HistoryList" ItemsSource="{Binding HistoryRows}"
                                 ItemTemplate="{StaticResource HistoryItemTemplate}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- 空状态（语言人格：动词句说清下一步）：列表为空时给出引导而非一片空白 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoryCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5"
                                           StrokeDashArray="3 2"
                                           Stroke="{DynamicResource Brush.BorderStrong}"/>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.History}"/>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="还没有落过印" HorizontalAlignment="Center" Margin="0,12,0,0"
                                       FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"/>
                            <TextBlock Text="翻译过的内容会自动收进这里（保留最近 5000 条）"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                       FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ==================== 藏印（FR-015 / 设计稿 §08） ==================== -->
        <TabItem Header="藏印" Tag="{StaticResource Glyph.Vocab}">
            <DockPanel Margin="20,26,32,44">
                <Grid DockPanel.Dock="Top" Style="{StaticResource SectionHead}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="12" Height="12" Style="{StaticResource Diamond}" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0">
                        <TextBlock Text="08" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                        <TextBlock Text="藏印" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="VOCABULARY" Style="{StaticResource SectionEyebrow}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="小窗里点星即收，独立于印谱清理；可导 CSV，也可直接推到 Anki。" Style="{StaticResource SectionDescription}"/>
                </Grid>

                <!-- 已藏：一条一枚印；重新载入与两只导出的手都挂在分组头右端 -->
                <StackPanel DockPanel.Dock="Top">
                    <Grid Style="{StaticResource GroupHeadSlot}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding VocabularyGroupTitle}" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                        <Border Grid.Column="2" Style="{DynamicResource HairlineFill}" Margin="9,0,0,0"/>
                        <!-- 重新载入：从最右端挪到刻痕内侧，把最右端让给两只导出的手 -->
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="22" Height="22" Margin="9,0,12,0"
                                ToolTip="重新载入藏印" Command="{Binding RefreshVocabularyCommand}">
                            <Viewbox Width="14" Height="14">
                                <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Refresh}"/>
                            </Viewbox>
                        </Button>
                        <!-- 导出的两只手：从印面下方搬上来，与「重新载入」同排靠右 -->
                        <Button Grid.Column="4" Content="导出 CSV" Style="{StaticResource Button.Outline}"
                                Padding="10,0" Height="26" FontSize="11.5"
                                Command="{Binding ExportVocabularyCsvCommand}"/>
                        <Button Grid.Column="5" Content="导出 Anki TSV" Style="{StaticResource Button.Outline}" Margin="10,0,0,0"
                                Padding="10,0" Height="26" FontSize="11.5"
                                Command="{Binding ExportVocabularyTsvCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Sheet}">
                        <Grid>
                            <ItemsControl x:Name="VocabularyList" ItemsSource="{Binding VocabularyItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LogRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34*"/>
                                                    <ColumnDefinition Width="66*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding SourceText}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           FontSize="14" FontWeight="{StaticResource Weight.Medium}"
                                                           Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TranslatedText}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Margin="0,0,14,0"/>
                                                <Border Grid.Column="2" Style="{StaticResource Tag.Line}" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding LanguagePairTag}" FontSize="11.5"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CreatedAtRelative}" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                                            Margin="7,0,0,0" ToolTip="把这条从藏印里取下来"
                                                            Command="{Binding DataContext.DeleteVocabularyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="15" Height="15">
                                                            <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Delete}"/>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 空状态：说清「去哪里点星」，比一片空白有用 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VocabularyItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5"
                                               StrokeDashArray="3 2"
                                               Stroke="{DynamicResource Brush.BorderStrong}"/>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Star}"/>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="还没有藏过印" HorizontalAlignment="Center" Margin="0,12,0,0"
                                           FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                <TextBlock Text="翻译时在小窗点一下星，词条就收进这里"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- FR-035（P0 批 2 / spec §1.4）：Anki 直推印面——只访问本机 29537，不经代理不上外网 -->
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,0">
                    <Grid Style="{StaticResource GroupHeadSlot}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Anki 直推" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                        <Border Grid.Column="2" Style="{DynamicResource HairlineFill}" Margin="9,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="仅访问 127.0.0.1:29537，不经代理" Margin="9,0,2,0"
                                   VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                    </Grid>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="启用 Anki 直推" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="需桌面版 Anki 装好 AnkiConnect；关闭后下面各项都不生效" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding AnkiEnabled}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="收藏时自动出卡" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="不占用译文落定链路，失败不影响收藏" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding AnkiPushOnFavorite}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SheetRow}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="牌组 / 笔记模板" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="{Binding AnkiDeckRowValue}" Style="{StaticResource RowDesc}"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="11.5"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="选择" Style="{StaticResource Button.Outline}"
                                                Padding="10,0" Height="26" FontSize="11.5"
                                                Command="{Binding ToggleAnkiDeckEditorCommand}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                Visibility="{Binding AnkiDeckEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="牌组" Width="72" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                                        <TextBox Width="170" Height="30" VerticalContentAlignment="Center"
                                                 Text="{Binding AnkiDeck, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                 ToolTip="Anki 里的牌组名，需完全一致"/>
                                        <TextBlock Text="笔记模板" Width="72" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Style="{StaticResource Text.Caption}"/>
                                        <TextBox Width="170" Height="30" VerticalContentAlignment="Center"
                                                 Text="{Binding AnkiModel, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                 ToolTip="如「基本」，需与 Anki 中模板名一致"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SheetRow}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="字段映射" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="{Binding AnkiFieldRowValue}" Style="{StaticResource RowDesc}"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="11.5"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="编辑" Style="{StaticResource Button.Outline}"
                                                Padding="10,0" Height="26" FontSize="11.5"
                                                Command="{Binding ToggleAnkiFieldEditorCommand}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                Visibility="{Binding AnkiFieldEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="正面字段" Width="72" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                                        <TextBox Width="170" Height="30" VerticalContentAlignment="Center"
                                                 Text="{Binding AnkiFrontField, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                 ToolTip="放原文的字段名（模板编辑界面可查）"/>
                                        <TextBlock Text="背面字段" Width="72" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Style="{StaticResource Text.Caption}"/>
                                        <TextBox Width="170" Height="30" VerticalContentAlignment="Center"
                                                 Text="{Binding AnkiBackField, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                 ToolTip="放译文的字段名"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="连接状态" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="Anki 未启动时会静默跳过，不弹错；推送重复项由 Anki 端判重" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Tag.Line}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AnkiConnectionOk}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AnkiConnectionTag}" FontSize="11.5"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="测试连接" Style="{StaticResource Button.Outline}"
                                            Padding="10,0" Height="26" FontSize="11.5"
                                            Command="{Binding TestAnkiCommand}"/>
                                    <Button Grid.Column="3" Content="全部直推" Style="{StaticResource Button.Outline}"
                                            Margin="10,0,0,0" Padding="10,0" Height="26" FontSize="11.5"
                                            Command="{Binding PushAllToAnkiCommand}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SheetRowLast}">
                                <TextBlock Text="{Binding AnkiStatusText}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VocabularyMessage}"
                           Style="{StaticResource Text.Caption}" Margin="2,10,0,0"/>

                <!-- 占满剩余行高，把两组印面顶在上方，底部反馈行贴着窗口下沿 -->
                <Border Background="Transparent"/>
            </DockPanel>
        </TabItem>

        <!-- ==================== 更新与数据（设计稿 §02） ==================== -->
        <TabItem Header="更新" Tag="{StaticResource Glyph.Update}" Visibility="{Binding ShowAdvancedSettings, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,26,32,44">
                <StackPanel>
                    <Grid Style="{StaticResource SectionHead}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="12" Height="12" Style="{StaticResource Diamond}" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0"><TextBlock Text="02" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/></Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock Text="更新" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="UPDATE &amp; DATA" Style="{StaticResource SectionEyebrow}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="单文件分发，数据可用便携模式写到 EXE 同目录。" Style="{StaticResource SectionDescription}"/>
                    </Grid>

                    <!-- 分组顺序照设计稿：版本 → 数据位置 → 备份 -->
                    <ContentControl Content="版本" Style="{StaticResource GroupHeadText}"/>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="当前版本" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="{Binding AppVersionText}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="检查更新" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0"
                                            VerticalAlignment="Center" Command="{Binding CheckUpdateCommand}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="更新清单地址" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="必须是 HTTPS；清单由内置公钥验签，安装包还会做 SHA-256 与大小校验" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="320" Height="32" Padding="10,0" VerticalContentAlignment="Center"
                                             Text="{Binding UpdateManifestUrl, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                             ToolTip="例如 https://example.com/TranslationApp/latest.json"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="启动后自动检查" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="只检查并在托盘提示，不自动下载或安装" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding UpdateAutoCheck}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="下载并安装" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="只在发现了新版本之后才可用；安装脚本失败会自动恢复上一版本" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="下载并安装" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DownloadAndInstallUpdateCommand}"
                                                IsEnabled="{Binding UpdateAvailable}"/>
                                        <ProgressBar Height="3" Margin="0,8,0,0" Maximum="1" Value="{Binding UpdateProgress}"
                                                     Visibility="{Binding UpdateBusy, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding UpdateMessage}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="2,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ContentControl Content="数据位置" Style="{StaticResource GroupHeadText}" Margin="10,20,0,10"/>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="便携模式" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="{Binding PortableNote}" Style="{StaticResource RowDesc}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 角标只在改过开关后亮：便携模式要重启才切落址，没改过不挂常驻提示 -->
                                        <Border Style="{StaticResource Tag.Line}" Margin="0,0,8,0"
                                                Visibility="{Binding PortableRestartPending, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="重启生效" FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        </Border>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding PortableMode}" IsEnabled="{Binding PortableAvailable}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="当前数据目录" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="{Binding DataFolderPath}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开目录" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0"
                                            VerticalAlignment="Center" Command="{Binding OpenDataFolderCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ContentControl Content="备份" Style="{StaticResource GroupHeadText}" Margin="10,20,0,10"/>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="导出备份" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="包含 settings.json 与一致性 history.db 快照，不含 API Key 明文" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="导出" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0"
                                            VerticalAlignment="Center" Command="{Binding CreateBackupCommand}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="从备份恢复" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="恢复前校验清单与 SHA-256，失败会自动回滚，不会留下半个库" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="选择文件" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0"
                                            VerticalAlignment="Center" Command="{Binding RestoreBackupCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding BackupMessage}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="2,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackupMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 定制印（P0 批 1：译文统一后置替换 / 设计稿 §09） ==================== -->
        <TabItem Header="定制印" Tag="{StaticResource Glyph.Glossary}" Visibility="{Binding ShowAdvancedSettings, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="20,26,32,44">
                <Grid DockPanel.Dock="Top" Style="{StaticResource SectionHead}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="12" Height="12" Style="{StaticResource Diamond}" Margin="7,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <Border Grid.Column="0" Style="{StaticResource SectionNo}" Margin="26,4,0,0">
                        <TextBlock Text="09" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.PrimaryText}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                        <TextBlock Text="定制印" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="GLOSSARY" Style="{StaticResource SectionEyebrow}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="你自己定下的译法，对所有引擎生效。长词优先、词边界感知，反向保护会跳过会撞车的替换。" Style="{StaticResource SectionDescription}"/>
                </Grid>

                <!-- 术语表 JSON 损坏（手改配置文件）时提示，保存一次即修复 -->
                <Border Style="{StaticResource Banner.Warning}" DockPanel.Dock="Top" Margin="0,0,0,14"
                        Visibility="{Binding GlossaryCorrupted, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="术语表无法读取，已按空表运行；在本页保存一次即可修复"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.Warning}"/>
                </Border>

                <!-- 词条：一行一枚印，最后一行就是落印台（源词 → 目标译法 → 添加） -->
                <StackPanel DockPanel.Dock="Top">
                    <Grid Style="{StaticResource GroupHeadSlot}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding GlossaryGroupTitle}" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                        <Border Grid.Column="2" Style="{DynamicResource HairlineFill}" Margin="9,0,0,0"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="9,0,2,0">
                            <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding GlossaryEnabled}"
                                      ToolTip="关闭后词条保留但不参与替换（切换场景模式时会联动此开关）"/>
                            <TextBlock Text="启用术语表" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <ItemsControl x:Name="GlossaryList" ItemsSource="{Binding GlossaryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Style="{StaticResource LogRow}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34*"/>
                                                        <ColumnDefinition Width="32*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="33*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Source}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               FontSize="14" FontWeight="{StaticResource Weight.Medium}"
                                                               Margin="0,0,14,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Target}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}"
                                                               Margin="0,0,14,0"/>
                                                    <Border Grid.Column="2" Margin="0,0,14,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Tag.Ok}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding EnabledTag}" FontSize="11.5"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding Summary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"
                                                               Margin="0,0,11,0"/>
                                                    <Grid Grid.Column="4">
                                                        <StackPanel x:Name="Actions" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="Collapsed">
                                                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                                    ToolTip="展开这条的完整设置（语言对 / 匹配方式 / 备注）"
                                                                    Command="{Binding ToggleEditorCommand}">
                                                                <Viewbox Width="15" Height="15">
                                                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Edit}"/>
                                                                </Viewbox>
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                                    ToolTip="删除词条"
                                                                    Command="{Binding DataContext.DeleteGlossaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Viewbox Width="15" Height="15">
                                                                    <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Delete}"/>
                                                                </Viewbox>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <!-- 展开：语言对作用范围、匹配方式、备注 -->
                                                <Grid Margin="0,12,0,0"
                                                      Visibility="{Binding EditorOpen, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="132"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="132"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" Height="{StaticResource Height.Control}"
                                                              ItemsSource="{Binding DataContext.GlossarySourceLanguageOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Code"
                                                              SelectedValue="{Binding SourceLanguage, Mode=TwoWay}"
                                                              ToolTip="源语言作用范围"/>
                                                    <TextBlock Grid.Column="1" Text="→" Margin="8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                    <ComboBox Grid.Column="2" Height="{StaticResource Height.Control}"
                                                              ItemsSource="{Binding DataContext.GlossaryTargetLanguageOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Code"
                                                              SelectedValue="{Binding TargetLanguage, Mode=TwoWay}"
                                                              ToolTip="目标语言作用范围"/>
                                                    <ComboBox Grid.Column="3" Height="{StaticResource Height.Control}" Margin="8,0,0,0"
                                                              ItemsSource="{Binding DataContext.GlossaryMatchOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Value"
                                                              SelectedValue="{Binding MatchMode, Mode=TwoWay}"
                                                              ToolTip="匹配方式"/>
                                                    <TextBox Grid.Column="4" Height="{StaticResource Height.Control}" Margin="8,0,0,0"
                                                             Padding="8,0" VerticalContentAlignment="Center"
                                                             FontSize="{StaticResource FontSize.Small}"
                                                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                             ToolTip="备注，不参与匹配"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 空状态：与印谱 / 藏印同款引导 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=GlossaryList}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5"
                                               StrokeDashArray="3 2"
                                               Stroke="{DynamicResource Brush.BorderStrong}"/>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.Glossary}"/>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="还没有定制过译法" HorizontalAlignment="Center" Margin="0,12,0,0"
                                           FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                <TextBlock Text="把产品名、专有名词的固定译法写在下方的落印台"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           FontSize="12.5" Foreground="{DynamicResource Brush.TextTertiary}"/>
                            </StackPanel>

                            <!-- 落印台：源词 → 目标译法 → 添加 -->
                            <Border Style="{StaticResource SheetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Height="{StaticResource Height.Control}" Padding="10,0"
                                             VerticalContentAlignment="Center" FontSize="{StaticResource FontSize.Small}"
                                             Text="{Binding NewGlossarySource, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="译文里实际出现的源词"/>
                                    <TextBlock Grid.Column="1" Text="→" Margin="10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBox Grid.Column="2" Height="{StaticResource Height.Control}" Padding="10,0"
                                             VerticalContentAlignment="Center" FontSize="{StaticResource FontSize.Small}"
                                             Text="{Binding NewGlossaryTarget, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="期望的固定译法"/>
                                    <Button Grid.Column="3" Content="添加" Style="{StaticResource Button.Primary}"
                                            Margin="10,0,0,0" Height="{StaticResource Height.Control}" Padding="16,0"
                                            Command="{Binding AddGlossaryCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 安全：反向保护常开（FR-041），导入导出随备份迁移 -->
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,0">
                    <ContentControl Content="安全" Style="{StaticResource GroupHeadText}"/>
                    <Border Style="{StaticResource Sheet}">
                        <StackPanel>
                            <Border Style="{StaticResource SheetRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="反向保护" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="目标词已经出现在原文里就不替换，防止把日常词误换" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="True" IsEnabled="False"
                                              ToolTip="反向保护常开，不可关闭（FR-041）"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SheetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="导入 / 导出" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="JSON（CSV / TSV）格式，可随备份一起迁移" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="导入" Style="{StaticResource Button.Outline}"
                                            Padding="10,0" Height="26" FontSize="11.5"
                                            Command="{Binding ImportGlossaryCommand}"/>
                                    <Button Grid.Column="2" Content="导出" Style="{StaticResource Button.Outline}"
                                            Margin="10,0,0,0" Padding="10,0" Height="26" FontSize="11.5"
                                            Command="{Binding ExportGlossaryCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding GlossaryMessage}"
                           Style="{StaticResource Text.Caption}" Margin="2,10,0,0"/>

                <Border Background="Transparent"/>
            </DockPanel>
        </TabItem>

        <!-- ==================== 高级（设计稿 §10：代理 / 输入与监听 / 本地词典 / 截图翻译 / 骑缝印） ==================== -->
        <TabItem Header="高级" Tag="{StaticResource Glyph.Advanced}" Visibility="{Binding ShowAdvancedSettings, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,26,32,44">
                <StackPanel>
                    <!-- ==================== 高级（设计稿 §10：网络代理 / 输入与监听 / 截图翻译 / 骑缝印） ==================== -->
                    <!-- 网络代理（FR-016） -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="网络代理" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="启用代理" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="用于访问在本地网络不可达的翻译引擎（如 Google）" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding ProxyEnabled}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}" IsEnabled="{Binding ProxyEnabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="作用范围" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="Bing / 腾讯 / 百度 国内可直连；选「仅国外引擎」只让 Google / Azure / DeepL / AI 走代理" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="330" VerticalAlignment="Center"
                                                  ItemsSource="{Binding ProxyModeOptions}"
                                                  SelectedValue="{Binding SelectedProxyMode}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}" IsEnabled="{Binding ProxyEnabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="地址与端口" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="如 127.0.0.1（Clash 默认混合端口 7897）" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Width="104" ItemsSource="{Binding ProxySchemeOptions}"
                                                      SelectedValue="{Binding ProxyScheme}"
                                                      SelectedValuePath="Value" DisplayMemberPath="Display"
                                                      ToolTip="代理协议：HTTP 或 SOCKS5"/>
                                            <TextBox Width="148" Margin="8,0,0,0"
                                                     Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     ToolTip="代理服务器地址"/>
                                            <TextBox Width="76" Margin="8,0,0,0"
                                                     Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     ToolTip="代理端口"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}" IsEnabled="{Binding ProxyEnabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="代理认证（可选）" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="密码以 DPAPI 加密保存，配置文件内无明文" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="120" Text="{Binding ProxyUserName, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     ToolTip="用户名"/>
                                            <PasswordBox x:Name="ProxyPasswordBox" Width="140" Margin="8,0,0,0"
                                                         Padding="10,0" VerticalContentAlignment="Center"
                                                         FontFamily="{StaticResource Font.App}" FontSize="{StaticResource FontSize.Small}"
                                                         PasswordChanged="OnProxyPasswordChanged"
                                                         ToolTip="密码（加密保存）"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="连通性" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="{Binding ProxyMessage}" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="测试代理连通性" Style="{StaticResource Button.Outline}"
                                                VerticalAlignment="Center"
                                                Command="{Binding TestProxyCommand}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 输入与监听：剪贴板 / 朗读 / 本地 HTTP 接口 -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="输入与监听" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="剪贴板监听" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="复制文本后自动弹出翻译小窗；3 秒内多次复制只处理最后一次" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding ClipboardMonitorEnabled}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="粘贴即译" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="输入框为空时 Ctrl+V 直接走取词链路，不再等一次剪贴板监听" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding PasteTranslateEnabled}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="划词后自动朗读原文" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="{Binding TtsHint}" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsEnabled="{Binding TtsAvailable}"
                                                  IsChecked="{Binding AutoSpeakAfterSelect}"/>
                                    </Grid>
                                </Border>
                                <!-- FR-053（批 5 / spec §5）：影子跟读——逐句朗读译文并高亮当前句，句间留跟读空隙 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="影子跟读（逐句朗读译文）" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="开启后译文区出现「跟读」：按句切开逐条朗读，当前句高亮，句间停顿留给你跟着念一遍。只用系统语音（SAPI），不联网、不上传文本" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="句间停顿" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                                            <TextBox Width="70" Margin="8,0,12,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding ShadowReadingEnabled}"
                                                     Text="{Binding ShadowPauseMs, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     ToolTip="毫秒，200~3000"/>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                      IsEnabled="{Binding TtsAvailable}"
                                                      IsChecked="{Binding ShadowReadingEnabled}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- FR-046（P0 批 4 / spec §4）：本地 HTTP API——仅回环 + token，隐私模式不监听 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="本地 HTTP 接口" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="供脚本 / 浏览器扩展 / AutoHotkey 调用：POST http://127.0.0.1:端口/api/translate，请求头 X-Auth 填 Token；只监听回环地址，不经代理、不对外网开放；隐私模式开启时不监听" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="端口" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                                            <TextBox Width="90" Margin="8,0,14,0" VerticalContentAlignment="Center"
                                                     Text="{Binding LocalApiPort, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="1024~65535"/>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                      IsChecked="{Binding LocalApiEnabled}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Token" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="界面只显掉码，重新生成会让旧 Token 立即失效" Style="{StaticResource RowDesc}"/>
                                            <TextBlock Text="{Binding LocalApiStatusText}" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LocalApiTokenMasked}" VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSize.Small}"/>
                                            <Button Content="复制 Token" Style="{StaticResource Button.Outline}" Margin="10,0,0,0"
                                                    Command="{Binding CopyLocalApiTokenCommand}"/>
                                            <Button Content="重新生成" Style="{StaticResource Button.Outline}" Margin="8,0,0,0"
                                                    Command="{Binding RegenerateLocalApiTokenCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 本地词典（FR-049 / FR-056）：设计稿未单列，沿用同款印面样式独立成组 -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="本地词典" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="划词/输入为单词时显示词典卡" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="只读本地文件、不产生网络请求；释义可并入 Anki 背面字段。仅支持 MDX v3（后端为 SQLite）的词典" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding DictionariesEnabled}"/>
                                    </Grid>
                                </Border>
                                <!-- FR-056：AI 词典兜底（会多花一次 API 额度，所以默认关） -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="本地没命中时用 AI 引擎补一条词典释义" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="让模型返回「词头 + 音标 + 简明释义」的结构化结果，显示在同一张词典卡上（来源标「AI 词典」）。每查一个词会多发一次请求、消耗 API 额度，因此默认关闭；不计入引擎看板，也不写历史" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding AiDictionaryEnabled}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DictionaryStatusText}" Style="{StaticResource RowDesc}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="110" Text="{Binding DictionaryTestWord, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="测试查询：看每份词典各自命中什么"/>
                                            <Button Content="测试" Style="{StaticResource Button.Outline}" Padding="10,4" Margin="6,0,0,0"
                                                    Command="{Binding TestDictionaryLookupCommand}"/>
                                            <Button Content="导入词典…" Style="{StaticResource Button.Outline}" Padding="10,4" Margin="6,0,0,0"
                                                    Command="{Binding ImportDictionaryCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding DictionaryItems}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize.Small}"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}"
                                                           TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="展开" Style="{StaticResource Button.Outline}" Padding="10,4"
                                                        Command="{Binding ToggleExpandedCommand}"/>
                                                <Button Content="删除" Style="{StaticResource Button.Outline}" Padding="10,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.DeleteDictionaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Shown}" Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding IsExpandedVisible, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 截图翻译（OCR）：截图链路 + 批量识别导出一并在同一张印面 -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="截图翻译（OCR）" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Hint}" Margin="17,0,0,8" MaxWidth="620"
                                   HorizontalAlignment="Left" TextAlignment="Left"
                                   Text="默认使用 Windows 自带的 OCR 引擎，无需联网下载，也不占用额外体积；可选 PaddleOCR 本地模型（识别更准，尤其斜体与小字），模型已内置、无需联网。可识别的语言由所选引擎决定。"/>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="截图结果处理方式" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="默认把选区图片钉在屏幕上原位置；需要旧行为（文本填入小窗）时在此切回。选「两者都做」时，点击钉图会让翻译小窗在 200ms 后自动隐藏（与点击小窗外部同一规则）" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="210" VerticalAlignment="Center"
                                                  ItemsSource="{Binding OcrOutputModeOptions}"
                                                  SelectedValue="{Binding OcrOutputMode}"
                                                  SelectedValuePath="Tag" DisplayMemberPath="Display"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="截图后自动翻译" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="关闭时仅把识别文本填入输入框，回车再翻译" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding OcrAutoTranslate}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="OCR 识别语言" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="「自动」跟随系统语言偏好；显式指定时会作为翻译的源语言" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  ItemsSource="{Binding OcrLanguageOptions}"
                                                  SelectedValue="{Binding OcrLanguage}"
                                                  SelectedValuePath="Tag" DisplayMemberPath="Display">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Modern}">
                                                    <Style.Triggers>
                                                        <!-- 语言包缺失：无可选项，直接置灰 -->
                                                        <DataTrigger Binding="{Binding OcrUnavailable}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <!-- 指定的语言不在系统可用列表 → 该项标红（13.2.5） -->
                                                        <DataTrigger Binding="{Binding OcrLanguageMissing}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <!-- FR-029-1（14.3.12.4）：识别前预处理（13.5.1） -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="识别前预处理" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="小字号或疑似漏识时自动放大并拉伸对比度后再识别一遍（择优采用），更准但略慢；关闭则仅识别原图" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="300" VerticalAlignment="Center"
                                                  ItemsSource="{Binding OcrPreprocessOptions}"
                                                  SelectedValue="{Binding OcrPreprocess}"
                                                  SelectedValuePath="Tag" DisplayMemberPath="Display"/>
                                    </Grid>
                                </Border>
                                <!-- FR-030（14.9.2 / 14.9.3）：本地识别引擎（13.5.1） -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="本地识别引擎" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="默认用 Windows 自带引擎（快）；PaddleOCR 内置本地模型（约 22MB，随程序附带），对斜体、小字、低对比度更准，但单次识别约慢 2~4 倍、程序体积更大；不可用时自动改回系统引擎并提示" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="300" VerticalAlignment="Center"
                                                  ItemsSource="{Binding OcrLocalEngineOptions}"
                                                  SelectedValue="{Binding OcrLocalEngine}"
                                                  SelectedValuePath="Tag" DisplayMemberPath="Display"/>
                                    </Grid>
                                </Border>
                                <!-- FR-030（14.9.2 / 14.9.3）：paddle 模型会话常驻开关 -->
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="PaddleOCR 模型常驻内存" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="默认关闭：空闲 5 分钟后自动释放模型会话，下次识别需约 0.5 秒重建；开启后保持常驻，识别零加载延迟，但常驻内存增加约 30MB" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding OcrPaddleResident}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="遮罩透明度" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="截图遮罩为固定深色，不随主题变化" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource Slider.Modern}" Width="150"
                                                    Minimum="0.2" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                    Value="{Binding OcrScrimOpacity}"/>
                                            <TextBlock Width="42" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                                       FontSize="{StaticResource FontSize.Small}"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding OcrScrimOpacityDisplay}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- FR-047（P0 批 4 / spec §5）：批量识别（仅图片） -->
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="批量识别导出" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="逐张走现有 OCR 引擎（与截图翻译同一链路），单张失败不中断；导出 Markdown 或纯文本，仅支持图片，PDF 请先转成图片" Style="{StaticResource RowDesc}"/>
                                            <TextBlock Text="{Binding BatchOcrStatusText}" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="选择图片…" Style="{StaticResource Button.Outline}"
                                                VerticalAlignment="Center"
                                                Command="{Binding StartBatchOcrCommand}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding OcrMessage}" TextWrapping="Wrap" MaxWidth="620" Margin="17,8,0,0"
                                   HorizontalAlignment="Left" TextAlignment="Left"
                                   FontSize="{StaticResource FontSize.Caption}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OcrMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OcrLanguageMissing}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 语言包缺失错误条（13.2.5 / 13.5.1）：仅在系统无 OCR 语言包时出现 -->
                        <Border Style="{StaticResource Banner.Error}" Margin="0,10,0,0"
                                Visibility="{Binding OcrUnavailable, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Error}" FontFamily="{StaticResource Font.Icon}"
                                           FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource Brush.Error}"/>
                                <TextBlock Text="{Binding OcrMessage}" TextWrapping="Wrap" MaxWidth="400"
                                           FontSize="{StaticResource FontSize.Small}"
                                           Foreground="{DynamicResource Brush.Error}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 骑缝印（钉图）：默认显示译文 / 缩放步进（FR-027） -->
                    <StackPanel Margin="0,0,0,20">
                        <Grid Style="{StaticResource GroupHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="骑缝印（钉图）" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                            <Border Grid.Column="2" Style="{StaticResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="默认显示译文" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="关闭时钉图先显示原文（译文已一并取好，不会再多发请求）；点工具条的切换按钮或按空格即显示译文" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding OcrInPlaceReplace}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="缩放步进" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="钉图里每格滚轮的等比倍数（1.02~2.0，默认 1.1）；Ctrl+滚轮调透明度，Shift+滚轮为精细缩放" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Width="76" VerticalAlignment="Center"
                                                 Text="{Binding PinZoomStep}"
                                                 ToolTip="等比缩放倍数：1.02~2.0，超出会被夹取"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SheetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="翻译失败时" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="钉图保持只读，工具条出现重试；Ctrl+F 强制重译" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <!-- 这行是固定行为的说明，不是可点的开关：不套胶囊边框，
                                             字号与左侧说明一致，避免看上去像枚按不动的按钮。 -->
                                        <TextBlock Grid.Column="1" Text="保留并把工具条改为常驻" Style="{StaticResource RowDesc}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>









