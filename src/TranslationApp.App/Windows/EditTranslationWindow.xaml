<Window x:Class="TranslationApp.Windows.EditTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑翻译记忆" Width="520" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.App}" FontSize="{StaticResource FontSize.Body}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="原文" Style="{StaticResource Text.Caption}"/>
        <TextBox Grid.Row="1" Margin="0,6,0,14" MinHeight="64" MaxHeight="120"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding SourceText, Mode=OneWay}"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="译文（可直接纠正）" Style="{StaticResource Text.Caption}"/>
            <TextBox x:Name="TranslatedBox" Margin="0,6,0,12" MinHeight="110"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding TranslatedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <CheckBox x:Name="ReviewedBox" Content="已校对" VerticalAlignment="Center"
                          Checked="OnReviewedChecked"/>
                <CheckBox x:Name="RejectedBox" Content="禁止 TM 复用" Margin="18,0,0,0" VerticalAlignment="Center"
                          Checked="OnRejectedChecked"/>
                <CheckBox x:Name="GlossaryBox" Content="加入术语表" Margin="18,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="已校对记录优先参与 TM；禁止复用会立即从候选池排除"
                       Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Margin="0,0,180,0"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Button.Outline}" Width="76"
                        Click="OnCancelClick"/>
                <Button Content="保存" Style="{StaticResource Button.Outline}" Width="76" Margin="8,0,0,0"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
