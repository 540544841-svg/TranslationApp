<Window x:Class="TranslationApp.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="速译 · 30 秒上手" Width="460" Height="336"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.App}" FontSize="{StaticResource FontSize.Body}">
    <!--
      FR-059（批 6 / spec §4）：首次运行的一次性上手卡。
      刻意不做多页向导、不收集任何数据；键帽文案取设置里的**真实热键**（用户改过热键也不能显示错的）。
    -->
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="30 秒上手" FontSize="{StaticResource FontSize.Title}"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="三个入口，选中文字就能译；用不上的可以在设置里关掉"
                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceSubtle}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" Height="30" Width="104"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Hotkey}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <TextBlock Text="现在就试：随便选中一段文字，按下划词翻译的热键"
                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                       Margin="0,0,120,0" TextWrapping="Wrap"/>
            <Button Content="知道了" Style="{StaticResource Button.Tonal}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    MinWidth="92" Height="30" IsDefault="True" Click="OnDismissClick"/>
        </Grid>
    </Grid>
</Window>
