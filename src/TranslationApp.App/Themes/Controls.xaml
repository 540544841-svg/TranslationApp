<!--
  控件样式与模板。全部颜色/Duration 走 DynamicResource，主题切换即时生效。
  状态层（Material 3）：悬停 = Hover 填充，按下 = Pressed 填充，聚焦 = Primary 描边 + 主色文字。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         基础文本样式
         ============================================================ -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semibold}"/>
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semibold}"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="Text.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 图标文字 -->
    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ============================================================
         图标按钮（图钉 / 关闭 / 交换 / 复制）
         ============================================================ -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Height.Small}"/>
        <Setter Property="Height" Value="{StaticResource Height.Small}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- 图标 glyph 通过 TextBlock 绑定按钮 Foreground（如钉图工具条），样式必须给默认前景色 -->
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮：悬停转为破坏性红（Apple 习惯） -->
    <Style x:Key="IconButton.Close" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <TextBlock x:Name="Glyph" Text="{StaticResource Icon.Close}"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ErrorBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         文字按钮（胶囊）
         ============================================================ -->
    <!-- 主按钮：填充主色（设置页「测试连接」等确定性动作） -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{DynamicResource Brush.Primary}"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 色调按钮（Tonal）：琥珀容器底 + 文字级琥珀，用于「复制译文」等次级主动作。
         文字用 PrimaryText（AA 达标）而非 Primary 填充色——琥珀填充压在容器底上对比不足 -->
    <Style x:Key="Button.Tonal" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Small}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{DynamicResource Brush.PrimaryContainer}"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 描边按钮（次要动作，如「恢复默认热键」） -->
    <Style x:Key="Button.Outline" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                        </Trigger>
                        <!-- 不可用态（如「测试连接」在必填字段为空时禁用）：整体降透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         输入框 / 只读结果区
         ============================================================ -->
    <Style x:Key="Field.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Content}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Field}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Field}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 聚焦：主色描边（不加粗，避免抖动） -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Window}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Cursor" Value="IBeam"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 密码/密钥输入框（引擎页的 SecretBox 用；外观与 Field.TextBox 完全一致，
         右侧留出「显示/隐藏」按钮的空间由使用方通过 Padding 指定） -->
    <Style x:Key="Field.PasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Field}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Window}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 只读结果区：无描边 + 略凹陷底色，与输入框形成「输入/输出」层次区分 -->
    <Style x:Key="Field.ReadOnlyResult" TargetType="TextBox" BasedOn="{StaticResource Field.TextBox}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="2,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                  HorizontalScrollBarVisibility="Disabled"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         滚动条（细、无箭头、悬停加深）
         ============================================================ -->
    <Style x:Key="ScrollBar.Thin" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="{DynamicResource Brush.ScrollThumb}"
                                                    Width="4" CornerRadius="2" HorizontalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}"/>
                                                    <Setter TargetName="T" Property="Width" Value="6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 横向滚动条：交换宽高与方向，避免与纵向共用模板时显示错乱 -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            <Setter TargetName="PART_Track" Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         复选框（18×18 圆角方框 + 主色对勾）
         ============================================================ -->
    <Style x:Key="CheckBox.Modern" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="{StaticResource Radius.Chip}"
                                Background="{DynamicResource Brush.Window}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Text="{StaticResource Icon.Check}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                       Foreground="{DynamicResource Brush.OnPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         开关（用于「开机自动启动」等即时生效的二元设置）
         ============================================================ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                            Background="{DynamicResource Brush.BorderStrong}">
                        <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                Background="{DynamicResource Brush.Window}"
                                HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25"
                                                  Color="{DynamicResource Color.Shadow}"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X" To="18"
                                                         Duration="{StaticResource Duration.Normal}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X" To="0"
                                                         Duration="{StaticResource Duration.Normal}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         不确定进度条 = 品牌形状语言「一道斜切的光」：
         琥珀流光带（两端渐隐 + 14° 斜切）沿轨道往复，与「译光闪落」签名、
         导航选中指示条共用同一母题（docs/brand-asset-sheet.html）。
         ============================================================ -->
    <Style x:Key="Progress.Indeterminate" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2" ClipToBounds="True">
                        <Border Width="96" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Signature.Streak}"
                                CornerRadius="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-14" AngleY="0"/>
                                    <TranslateTransform X="-120"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <!--
                              动画必须挂在被动画元素自己的 Triggers 上、且不写 TargetName：
                              写在 ControlTemplate.Triggers 里时，窗口尺寸变化会重新广播 Loaded，
                              此时 BeginStoryboard 拿到的 namescope 解析不到模板内的命名元素，
                              抛「无法在 ControlTemplate 的名称范围内找到名称」（运行日志每次启动必现）。
                              属性路径要穿过 TransformGroup，因为 Transform 是 Freezable。
                            -->
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="-120" To="420" Duration="0:0:1.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         下拉选择（紧凑「无框」风格：默认透明，悬停浅底，弹出层圆角 + 阴影）
         ============================================================ -->
    <Style x:Key="ComboBoxItem.Modern" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius.Chip}"
                            Margin="3,1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock x:Name="Tick" Text="{StaticResource Icon.Check}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                       Foreground="{DynamicResource Brush.PrimaryText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBox.Modern" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Modern}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root" Background="Transparent"
                                CornerRadius="{StaticResource Radius.Control}"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBlock x:Name="Chevron" Grid.Column="1" Margin="6,0,0,0"
                                       Text="{StaticResource Icon.ChevronDown}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="8" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Brush.Window}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Effect="{StaticResource Shadow.Popup}">
                                <ScrollViewer Padding="0,4" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         设置窗口左侧导航（重写 TabControl 模板：TabStrip 竖排于左）
         ============================================================ -->
    <!--
      设置窗口左侧导航（重写 TabControl 模板：TabStrip 竖排于左）。
      选中态 = 琥珀容器底 + 文字级琥珀 + 左侧品牌形状语言「斜切光带」指示条
      （3px 琥珀竖条右倾 14°，与进度条 / 译光闪落同一母题——docs/brand-asset-sheet.html）。
    -->
    <Style x:Key="NavItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root" Height="{StaticResource Height.Large}" Margin="8,2"
                            CornerRadius="{StaticResource Radius.Control}" Background="Transparent">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 品牌形状语言：选中指示光带（默认收起不占位） -->
                            <Border x:Name="Streak" Grid.Column="0" Width="3" Height="16"
                                    CornerRadius="2" Margin="0,0,8,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource Brush.Primary}"
                                    RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <SkewTransform AngleX="-14" AngleY="0"/>
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock x:Name="Icon" Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="14"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                            <Setter TargetName="Streak" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                            <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabControl.Nav" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 侧栏 -->
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                                    <TextBlock Text="速译" Margin="18,0,0,2"
                                               FontFamily="{StaticResource Font.App}"
                                               FontSize="{StaticResource FontSize.Title}"
                                               FontWeight="{StaticResource Weight.Semibold}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <!-- 品牌形状语言：应用名下的斜切光带（形状签名在入口触点的落位） -->
                                    <Border Width="22" Height="3" CornerRadius="2" Margin="18,0,0,4"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.Signature.Streak}"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <SkewTransform AngleX="-14" AngleY="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <TextBlock Text="划词 · 截图 · 即译" Margin="18,0,0,12"
                                               Style="{StaticResource Text.Caption}"/>
                                    <!-- 纵向导航必须用 StackPanel 作为项宿主：
                                         TabPanel 是横向标签条容器，会自行折行并打乱顺序 -->
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 内容区 -->
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Window}">
                            <!-- 必须叫 PART_SelectedContentHost：TabControl.OnApplyTemplate 按这个名字认领内容宿主，
                                 缺了它整块内容不在 TabControl 的焦点/自动化作用域里——表现为「输入框点进去敲不进字」，
                                 且 UIA 控件视图里只剩导航项、看不到任何内容控件（实测）。 -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         卡片（设置项分组容器）
         ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- 分组内分隔线 -->
    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>

    <!-- ============================================================
         提示条（错误 / 信息）
         ============================================================ -->
    <Style x:Key="Banner.Error" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- 提示条（警告 / 信息），用于「端点不可达」「请开启代理」这类非致命提示 -->
    <Style x:Key="Banner.Warning" TargetType="Border" BasedOn="{StaticResource Banner.Error}">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningContainer}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarningBorder}"/>
    </Style>

    <!-- ============================================================
         状态徽标（引擎页：已配置 / 未配置）
         底色与描边在此定义，「已配置」时由使用方的 DataTrigger 换成主色令牌
         ============================================================ -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 链接按钮：无底透明，用于「高级选项」「恢复默认」这类低权重动作 -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Small}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Chip}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         滑块（AI 引擎的采样温度；OCR 遮罩透明度复用）
         轨道用 SurfaceMuted，已选段与滑块用主色，与 ProgressBar 同一层次
         ============================================================ -->
    <Style x:Key="Slider.Modern" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- 未选段轨道 -->
                        <Border Height="4" CornerRadius="2"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{DynamicResource Brush.Primary}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Width="14" Height="14" Fill="{DynamicResource Brush.Window}"/>
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Primary}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         工具提示
         ============================================================ -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Chip}" Padding="8,5"
                            Effect="{StaticResource Shadow.Popup}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         右键菜单（ContextMenu / MenuItem 全局隐式样式，B-②③）
         WPF 默认模板硬编码三个浅色 Rectangle（深色主题下的"白色圆角竖条"即来源于此），
         必须整体重写模板。规格对齐 ComboBox.Modern 弹层：Margin=8 阴影位 + Window 底 +
         Border 描边 + Radius.Card + Shadow.Popup；MenuItem 对齐 ComboBoxItem.Modern（无图标槽）。
         ============================================================ -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="8" Padding="6,4"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}"
                            Effect="{StaticResource Shadow.Popup}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- 菜单内分隔线：1px 令牌色，上下留 4 -->
            <Style TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="0,4"
                                    Background="{DynamicResource Brush.Border}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{StaticResource Radius.Chip}" Margin="3,1" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <!-- 快捷键提示（InputGestureText 槽）；带图标项本批不需要，后续可扩展 -->
                            <TextBlock Grid.Column="1" Margin="16,0,0,0"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Brush.TextTertiary}" Opacity="0.7"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         全局隐式样式（未显式指定样式时的默认观感）
         ============================================================ -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Field.TextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Modern}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Modern}"/>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource Progress.Indeterminate}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Thin}"/>
</ResourceDictionary>
