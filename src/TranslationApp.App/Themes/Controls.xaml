<!--
  控件样式与模板。全部颜色/Duration 走 DynamicResource，主题切换即时生效。
  状态层（Material 3）：悬停 = Hover 填充，按下 = Pressed 填充，聚焦 = Primary 描边 + 主色文字。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         基础文本样式
         ============================================================ -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semibold}"/>
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semibold}"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    </Style>

    <Style x:Key="Text.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 图标文字 -->
    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ============================================================
         图标按钮（图钉 / 关闭 / 交换 / 复制）
         ============================================================ -->
    <!-- 键盘焦点环：统一的可见焦点样式，Tab 导航时能看清当前落点。 -->
    <Style x:Key="FocusRing" TargetType="Border">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Margin" Value="-2"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Height.Small}"/>
        <Setter Property="Height" Value="{StaticResource Height.Small}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- 图标 glyph 通过 TextBlock 绑定按钮 Foreground（如钉图工具条），样式必须给默认前景色 -->
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮：悬停转为破坏性红（Apple 习惯） -->
    <Style x:Key="IconButton.Close" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <TextBlock x:Name="Glyph" Text="{StaticResource Icon.Close}"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="{StaticResource FontSize.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ErrorBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         文字按钮（胶囊）
         ============================================================ -->
    <!-- 主按钮：填充主色（设置页「测试连接」等确定性动作） -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{DynamicResource Brush.Primary}"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.OnPrimary}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 色调按钮（Tonal）：琥珀容器底 + 文字级琥珀，用于「复制译文」等次级主动作。
         文字用 PrimaryText（AA 达标）而非 Primary 填充色——琥珀填充压在容器底上对比不足 -->
    <Style x:Key="Button.Tonal" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Small}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{DynamicResource Brush.PrimaryContainer}"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 描边按钮（次要动作，如「恢复默认热键」） -->
    <Style x:Key="Button.Outline" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                        </Trigger>
                        <!-- 不可用态（如「测试连接」在必填字段为空时禁用）：整体降透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         输入框 / 只读结果区
         ============================================================ -->
    <Style x:Key="Field.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Content}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Field}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- 设计稿 .field：白印面 + 一道较深的发丝线（不能再用阴刻底，否则在白印面上像禁用态） -->
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Field}">
                        <!-- PART_ContentHost 必须跟随 VerticalContentAlignment：调用方一旦给了固定 Height，
                             不居中的话文字按视口顶部排布，视口比行高还矮时直接被裁掉（术语表行实测：
                             Height 30 − Padding 8×2 − 边框 2 = 12px 视口，12 号字要 16px，字在控件里但看不见）。 -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 聚焦：主色描边（不加粗，避免抖动） -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Window}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Cursor" Value="IBeam"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 密码/密钥输入框（引擎页的 SecretBox 用；外观与 Field.TextBox 完全一致，
         右侧留出「显示/隐藏」按钮的空间由使用方通过 Padding 指定） -->
    <Style x:Key="Field.PasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Field}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Window}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 只读结果区：无描边 + 略凹陷底色，与输入框形成「输入/输出」层次区分 -->
    <Style x:Key="Field.ReadOnlyResult" TargetType="TextBox" BasedOn="{StaticResource Field.TextBox}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="2,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                  HorizontalScrollBarVisibility="Disabled"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         滚动条（细、无箭头、悬停加深）
         ============================================================ -->
    <Style x:Key="ScrollBar.Thin" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="{DynamicResource Brush.ScrollThumb}"
                                                    Width="4" CornerRadius="2" HorizontalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}"/>
                                                    <Setter TargetName="T" Property="Width" Value="6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 横向滚动条：交换宽高与方向，避免与纵向共用模板时显示错乱 -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            <Setter TargetName="PART_Track" Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         复选框（18×18 圆角方框 + 主色对勾）
         ============================================================ -->
    <Style x:Key="CheckBox.Modern" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="{StaticResource Radius.Chip}"
                                Background="{DynamicResource Brush.Window}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Text="{StaticResource Icon.Check}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                       Foreground="{DynamicResource Brush.OnPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         分段控件（设计稿 .seg）：三态选择落在阴刻底的药丸里，
         选中项是一枚浮起的小印面。用于「跟随系统 / 纸 / 墨」这类少而互斥的选择。
         ============================================================ -->
    <Style x:Key="Seg" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Sidebar}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Brand.Radius.Control}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Seg.Btn" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <!-- 选中印面：靠透明度淡入淡出，不做布局突变，切换才是「丝滑」的 -->
                        <Border x:Name="Pill" CornerRadius="4" Opacity="0"
                                Background="{DynamicResource Brush.Surface}"/>
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Margin="12,0" Height="26" VerticalAlignment="Center"
                                   TextOptions.TextFormattingMode="Ideal"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Duration.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Duration.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         开关（用于「开机自动启动」等即时生效的二元设置）
         ============================================================ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                            Background="{DynamicResource Brush.BorderStrong}">
                        <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                Background="{DynamicResource Brush.Window}"
                                HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25"
                                                  Color="{DynamicResource Color.Shadow}"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X" To="18"
                                                         Duration="{StaticResource Duration.Normal}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X" To="0"
                                                         Duration="{StaticResource Duration.Normal}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         不确定进度条 = 品牌形状语言「一道斜切的光」：
         琥珀流光带（两端渐隐 + 14° 斜切）沿轨道往复，与「译光闪落」签名、
         导航选中指示条共用同一母题（已退役的 v2.0 琥珀资产表）。
         ============================================================ -->
    <Style x:Key="Progress.Indeterminate" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2" ClipToBounds="True">
                        <Border Width="96" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Signature.Streak}"
                                CornerRadius="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-14" AngleY="0"/>
                                    <TranslateTransform X="-120"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <!--
                              动画必须挂在被动画元素自己的 Triggers 上、且不写 TargetName：
                              写在 ControlTemplate.Triggers 里时，窗口尺寸变化会重新广播 Loaded，
                              此时 BeginStoryboard 拿到的 namescope 解析不到模板内的命名元素，
                              抛「无法在 ControlTemplate 的名称范围内找到名称」（运行日志每次启动必现）。
                              属性路径要穿过 TransformGroup，因为 Transform 是 Freezable。
                            -->
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="-120" To="420" Duration="0:0:1.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         下拉选择（紧凑「无框」风格：默认透明，悬停浅底，弹出层圆角 + 阴影）
         ============================================================ -->
    <Style x:Key="ComboBoxItem.Modern" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius.Chip}"
                            Margin="3,1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock x:Name="Tick" Text="{StaticResource Icon.Check}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                       Foreground="{DynamicResource Brush.PrimaryText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBox.Modern" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Modern}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root" Background="Transparent"
                                CornerRadius="{StaticResource Radius.Control}"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBlock x:Name="Chevron" Grid.Column="1" Margin="6,0,0,0"
                                       Text="{StaticResource Icon.ChevronDown}"
                                       FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="8" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Brush.Window}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Effect="{StaticResource Shadow.Popup}">
                                <ScrollViewer Padding="0,4" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         设置窗口左侧导航：84px 印架 + 顶部品牌条 + 右侧骑缝书脊
         ============================================================ -->
    <!-- 印谱检索行的筛选胶囊（设计稿 .tag.line）：外观是一枚胶囊，点开走同一套弹层 -->
    <Style x:Key="ComboBox.Pill" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Modern}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Brand.Radius.Chip}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Viewbox Grid.Column="1" Width="11" Height="11" Margin="5,0,0,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon.Line}" Data="{StaticResource Glyph.ChevronDown}" StrokeThickness="1.9"/>
                            </Viewbox>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="8" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Brush.Window}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Effect="{StaticResource Shadow.Popup}">
                                <ScrollViewer Padding="0,4" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 胶囊形态的开关（设计稿 .tag.line ↔ .tag.vermilion）：用于「只看固定」这类单枚筛选 -->
    <Style x:Key="PillToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Root" Height="20" CornerRadius="{StaticResource Brand.Radius.Chip}"
                            BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}"
                            Background="Transparent" Padding="7,0">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         设置窗口左侧导航：84px 印架 + 顶部品牌条 + 右侧骑缝书脊
         ============================================================ -->
    <!--
      设置窗口外壳对齐最终设计稿：顶部品牌条负责「译印 / 当前分区」，
      左侧 84px 印架负责分区导航；内容区保留一条骑缝书脊，品牌几何只露在缝里。
    -->
    <Style x:Key="NavItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Root" Width="64" Height="52" CornerRadius="{StaticResource Brand.Radius.Seal}"
                                Background="Transparent" Cursor="Hand"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 图标：设计稿 24x24 描边图形，套 Viewbox 缩到 19px（连笔画一起缩） -->
                            <Viewbox Width="19" Height="19" HorizontalAlignment="Center">
                                <Path x:Name="Icon" Style="{StaticResource Icon.Line}"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Viewbox>
                            <!-- 标签：隐式 TextBlock 样式会把前景写死成墨色（继承赢不了 style setter），
                                 所以这里必须显式 TemplateBinding，选中态的 on-vermilion 才落得下去。 -->
                            <TextBlock x:Name="Label" Text="{TemplateBinding Header}" Margin="0,4,0,0"
                                       FontSize="10.5" HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <Border x:Name="Diamond" Width="6" Height="6" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="0" Visibility="Collapsed"
                                Background="{DynamicResource Brush.Primary}"
                                RenderTransformOrigin=".5,.5">
                            <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                            <Setter TargetName="Diamond" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.OnPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 印面标：品牌记号（圆角印面 + 刻掉的负形箭标），Stretch=Uniform 可任意缩放。
         必须定义在 TabControl.Nav 之前：StaticResource 在模板里只能引用本字典中更早出现的资源。-->
    <Style x:Key="BrandMark" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource Brand.Mark.Geometry}"/>
        <Setter Property="Fill" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- ==================== 标题栏帽檐按钮（设计稿 .win-caps）====================
         40x40 无描边，悬停沉到 carved；关闭键悬停落朱砂实底 + 白字（.win-caps .close:hover）。
         字形进模板而不是按钮 Content：Path.Stroke 不继承 Foreground，只有把字形放进模板
         才能用 TemplateBinding 让它跟着按钮前景色走（悬停换色全靠这一条）。
         Tag 在这套样式里被征用成「本枚按钮用哪个字形」，所以别再给它们写业务 Tag。 -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource Icon.Caption}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}"/>
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionButton.Min" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Tag" Value="{StaticResource Glyph.WinMin}"/>
        <Setter Property="Command" Value="{x:Static SystemCommands.MinimizeWindowCommand}"/>
    </Style>

    <!-- 中间那枚是「最大化 / 还原」同一枚：字形与命令都跟着 WindowState 换。 -->
    <Style x:Key="CaptionButton.Max" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Tag" Value="{StaticResource Glyph.WinMax}"/>
        <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Tag" Value="{StaticResource Glyph.WinRestore}"/>
                <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Tag" Value="{StaticResource Glyph.WinClose}"/>
        <Setter Property="Command" Value="{x:Static SystemCommands.CloseWindowCommand}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabControl.Nav" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Window}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"/>
                        <!-- 品牌 + 面包屑跨两列：以前只在 84px 的导航列里，后面的当前分区名被裁掉（实测只剩「译印 /」） -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <!-- 印面标：标题栏只留品牌记号本身，不再用「译」字代替 -->
                            <Path Style="{StaticResource BrandMark}" Width="18" Height="18"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="译印" Margin="8,0,8,0" FontSize="13"
                                       FontWeight="{StaticResource Weight.Semibold}" VerticalAlignment="Center"/>
                            <TextBlock Text="/" Margin="0,0,8,0" Opacity=".4" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <!-- 整条 40px 帽檐都在 WindowChrome 的 CaptionHeight 里，不显式声明命中可见
                                 就会整块被当成拖拽区：按钮看得见、点不动（这就是之前那三枚「死键」的成因）。 -->
                            <Button Style="{StaticResource CaptionButton.Min}"/>
                            <Button Style="{StaticResource CaptionButton.Max}"/>
                            <Button Style="{StaticResource CaptionButton.Close}"/>
                        </StackPanel>
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                            <ScrollViewer Padding="0,10" VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.Window}">
                            <!-- 必须叫 PART_SelectedContentHost，否则焦点与 UIA 会丢失内容宿主。 -->
                            <Grid>
                                <!-- 骑缝书脊落在各分区标题那颗方菱形的中心（内容左内边距 24 + 菱形中心 -13），
                                     这样整页的分缝都从印面标的菱形里穿过，而不是另起一条平行线。 -->
                                <Border HorizontalAlignment="Left" Width="1" Margin="33,26,0,44"
                                        Background="{DynamicResource Brush.Spine}" IsHitTestVisible="False"/>
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         卡片（设置项分组容器）
         ============================================================ -->
    <!-- 工作台快捷动作卡（设计稿 .wb-q）：白印面 + 发丝描边，hover 转朱砂 -->
    <Style x:Key="QuickAction" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Brand.Radius.Seal}"/>
        <Setter Property="Padding" Value="13,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionHead" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,22"/>
    </Style>

    <Style x:Key="Diamond" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
        <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CreedCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="14,9,14,10"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Popup}"/>
    </Style>

    <Style x:Key="SectionNo" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Brand.Radius.Chip}"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="GroupDiamond" TargetType="Border" BasedOn="{StaticResource Diamond}">
        <Setter Property="Width" Value="{StaticResource Brand.Chisel.Diamond}"/>
        <Setter Property="Height" Value="{StaticResource Brand.Chisel.Diamond}"/>
    </Style>

    <!-- 阳刻角标：译文区四角那对 9x9 朱砂细角（设计稿 .wb-dst::before / ::after） -->
    <Style x:Key="SealCorner" TargetType="Border">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="Margin" Value="9"/>
        <Setter Property="Opacity" Value="0.28"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
    </Style>

    <!-- 骑缝齿：1x6 竖条，间距 3（设计稿 .ticks）；已盖印的齿由使用方换成朱砂 -->
    <Style x:Key="ChiselTick" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Brand.Chisel.TickWidth}"/>
        <Setter Property="Height" Value="{StaticResource Brand.Chisel.TickHeight}"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.BorderStrong}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="LineHeight" Value="33.6"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    </Style>

    <Style x:Key="SectionEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="SectionDescription" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="310"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="GroupHeader" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="10,0,0,10"/>
    </Style>

    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Semibold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================
         表单：印面容器 + 设置行（设计稿 .group / .sheet / .row）
         ============================================================ -->
    <Style x:Key="GroupHead" TargetType="Grid">
        <Setter Property="Margin" Value="10,0,0,10"/>
    </Style>

    <!-- 只有标题的分组头（第二行起用 Margin="10,22,0,10"） -->
    <Style x:Key="GroupHeadText" TargetType="ContentControl">
        <Setter Property="Margin" Value="10,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource GroupDiamond}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Style="{StaticResource GroupTitle}" Margin="9,0,0,0"/>
                        <Border Grid.Column="2" Style="{DynamicResource HairlineFill}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 印面：设置分组的内容容器，行与行之间由 SheetRow 的发丝线分隔 -->
    <Style x:Key="Sheet" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Brand.Radius.Seal}"/>
    </Style>

    <Style x:Key="SheetRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="20,13"/>
    </Style>

    <!-- 分组内最后一行不带分隔线（设计稿 .row:last-child） -->
    <Style x:Key="SheetRowLast" TargetType="Border" BasedOn="{StaticResource SheetRow}">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 自检清单行（设计稿 .prog-list .pi）：11/16 内边距，行底一条发丝线，末行换成 ProgressRowLast -->
    <Style x:Key="ProgressRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,11"/>
    </Style>

    <Style x:Key="ProgressRowLast" TargetType="Border" BasedOn="{StaticResource ProgressRow}">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 印谱 / 藏印的扁平行（设计稿 .log .li 与 .word-item）：16/12 内边距、行底发丝线，
         悬停整行浮现朱砂淡底。末行换成 LogRowLast。 -->
    <Style x:Key="LogRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LogRowLast" TargetType="Border" BasedOn="{StaticResource LogRow}">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 分组头带一枚右侧控件（设计稿 .group-h 的 hint 位）：菱形 / 标题 / 横刻痕 / 控件 -->
    <Style x:Key="GroupHeadSlot" TargetType="Grid">
        <Setter Property="Margin" Value="10,0,0,10"/>
    </Style>

    <Style x:Key="ProgressRowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 等宽证据列（设计稿 .pi 里那段 mono 11px/ink-3） -->
    <Style x:Key="ProgressEvidence" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="LineHeight" Value="21.6"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RowDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="19.2"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Brand.Radius.Chip}"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- 设计稿 .tag：文字 ink-2 / 11.5 / 500，由外层统一下发，用处不必逐处声明 -->
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="TextElement.FontSize" Value="11.5"/>
        <Setter Property="TextElement.FontWeight" Value="{StaticResource Weight.Medium}"/>
    </Style>

    <Style x:Key="Tag.Vermilion" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
    </Style>

    <Style x:Key="Tag.Line" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
    </Style>

    <!-- 状态胶囊变体（设计稿 .tag.ok / .tag.warn / .tag.bad）：
         背景用各自的 soft 色，文字用对应的 deep 色。
         文字色走 TextElement.Foreground 继承下发，用处只需改背景一项。 -->
    <Style x:Key="Tag.Ok" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryContainerHover}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
    </Style>

    <Style x:Key="Tag.Warn" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningContainer}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}"/>
    </Style>

    <Style x:Key="Tag.Bad" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Error}"/>
    </Style>

    <Style x:Key="Tag.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="{StaticResource Weight.Medium}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- 可点的标签（设计稿 .tag）：阴刻底小药丸，当前档换成朱砂实心。
         场景档案用它代替一排按钮——切换档案本就该像按印一样轻。 -->
    <Style x:Key="TagButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Height="20" Padding="7,0"
                            CornerRadius="{StaticResource Brand.Radius.Chip}"
                            Background="{DynamicResource Brush.Sidebar}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{StaticResource Weight.Medium}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.PrimaryContainer}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标签上的删除粒：小小一枚 ×，悬停才转危色 -->
    <Style x:Key="TagDeleteButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Width="20" Height="20"
                            CornerRadius="{StaticResource Brand.Radius.Chip}"
                            Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HairlineFill" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Brand.Radius.Seal}"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- 分组内分隔线 -->
    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>

    <!-- ============================================================
         提示条（错误 / 信息）
         ============================================================ -->
    <Style x:Key="Banner.Error" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.ErrorContainer}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- 提示条（警告 / 信息），用于「端点不可达」「请开启代理」这类非致命提示 -->
    <Style x:Key="Banner.Warning" TargetType="Border" BasedOn="{StaticResource Banner.Error}">
        <Setter Property="Background" Value="{DynamicResource Brush.WarningContainer}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarningBorder}"/>
    </Style>

    <!-- ============================================================
         状态徽标（引擎页：已配置 / 未配置）
         底色与描边在此定义，「已配置」时由使用方的 DataTrigger 换成主色令牌
         ============================================================ -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 链接按钮：无底透明，用于「高级选项」「恢复默认」这类低权重动作 -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Small}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Chip}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         滑块（AI 引擎的采样温度；OCR 遮罩透明度复用）
         轨道用 SurfaceMuted，已选段与滑块用主色，与 ProgressBar 同一层次
         ============================================================ -->
    <Style x:Key="Slider.Modern" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- 未选段轨道 -->
                        <Border Height="4" CornerRadius="2"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{DynamicResource Brush.Primary}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Width="14" Height="14" Fill="{DynamicResource Brush.Window}"/>
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Primary}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         工具提示
         ============================================================ -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Chip}" Padding="8,5"
                            Effect="{StaticResource Shadow.Popup}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         右键菜单（ContextMenu / MenuItem 全局隐式样式，B-②③）
         WPF 默认模板硬编码三个浅色 Rectangle（深色主题下的"白色圆角竖条"即来源于此），
         必须整体重写模板。规格对齐 ComboBox.Modern 弹层：Margin=8 阴影位 + Window 底 +
         Border 描边 + Radius.Card + Shadow.Popup；MenuItem 对齐 ComboBoxItem.Modern（无图标槽）。
         ============================================================ -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="8" Padding="6,4"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}"
                            Effect="{StaticResource Shadow.Popup}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- 菜单内分隔线：1px 令牌色，上下留 4 -->
            <Style TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="0,4"
                                    Background="{DynamicResource Brush.Border}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{StaticResource Radius.Chip}" Margin="3,1" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <!-- 快捷键提示（InputGestureText 槽）；带图标项本批不需要，后续可扩展 -->
                            <TextBlock Grid.Column="1" Margin="16,0,0,0"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Brush.TextTertiary}" Opacity="0.7"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         全局隐式样式（未显式指定样式时的默认观感）
         ============================================================ -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Field.TextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Modern}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Modern}"/>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource Progress.Indeterminate}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Thin}"/>
    <!-- 窗口默认必须是箭头：手型只属于启用中的可点击控件。 -->
    <Style TargetType="Window">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

</ResourceDictionary>









