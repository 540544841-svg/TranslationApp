<!--
  译印 INKSEAL · 墨（深色）主题色板
  ============================================================================
  译印的深色主题。ThemeManager 按路径整本替换本文件实现即时换肤（合并位置 [0]）。

  取值标注：
    [稿] = 设计稿原值，来自 design-v4/inkseal-ui.html 的 [data-theme="ink"] CSS 变量
    [补] = 设计稿未覆盖该语义键，按其品牌规则推导补齐，已注明依据
    注释里引用 CSS 变量时省去了开头的两个短横线（XML 注释不允许连续短横线）。

  墨模式的品牌规则（与纸模式同一套，只换明度方向）：
    朱砂在暗底上要提亮到 #E2564A 才不糊；纸变成墨 #0F1114，印面变成 #191C20。
    语义完全不变：成功仍 = 盖上了印（朱砂），失败仍 = 冷绯。
    暗底上「印」比亮底更明显——这正是刻印的本相：墨拓。

  对比度（WCAG 2.1，墨底 #0F1114）：
    TextPrimary   #F0F1F3 ≈ 16:1   AAA
    TextSecondary #989EA6 ≈ 7.6:1  AAA
    TextTertiary  #7C838C ≈ 4.7:1  AA（见下方说明）
    PrimaryText   #F08A7C ≈ 7.1:1  AA（正文级）
    OnPrimary     #2B0B06 / 亮朱砂 ≈ 5.9:1  AA
    ScrollThumb   #343941 仅装饰；悬停 #E2564A ≈ 4.6:1（用户明确要求墨模式滚动条不能是白的）
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 表面与背景 =================
         墨 < 阴刻？不——墨模式里「阴刻」比底更暗，是凹进去的槽；
         印面比底更亮，是浮起来的纸。层次方向与纸模式相反，但三级关系一致。 -->
<Color x:Key="Color.Window">#FF0F1114</Color>          <!-- [稿] paper 墨 -->
<Color x:Key="Color.Surface">#FF191C20</Color>         <!-- [稿] sheet 印面 -->
    <Color x:Key="Color.Sidebar">#FF0A0C0E</Color>         <!-- [稿] carved 阴刻（更暗） -->
    <Color x:Key="Color.SurfaceSubtle">#FF191C20</Color>   <!-- [稿] sheet 印面（更亮） -->
    <Color x:Key="Color.SurfaceMuted">#FF21252C</Color>    <!-- [补] 比印面再亮一级，对齐暗色主题 muted > subtle 的关系 -->
    <Color x:Key="Color.Border">#FF262A30</Color>          <!-- [稿] hairline -->
    <Color x:Key="Color.BorderStrong">#FF343941</Color>    <!-- [稿] hairline-strong -->
    <Color x:Key="Color.Hover">#FF21252C</Color>           <!-- [补] 与 SurfaceMuted 同值，沿用暗色主题惯例 -->
    <Color x:Key="Color.Pressed">#FF2A3037</Color>         <!-- [补] 比 hover 再亮一级 -->

    <!-- ================= 文字 ================= -->
    <Color x:Key="Color.TextPrimary">#FFF0F1F3</Color>     <!-- [稿] ink -->
    <Color x:Key="Color.TextSecondary">#FF989EA6</Color>   <!-- [稿] ink-2 -->
    <!-- [补] 设计稿的 ink-3 #6C727A 在墨底只有 3.8:1，仅够 11px 以下标注使用；
         此处 TextTertiary 承载正文级说明文字，故取 #7C838C 达到 AA。 -->
    <Color x:Key="Color.TextTertiary">#FF7C838C</Color>
    <Color x:Key="Color.TextDisabled">#FF565C64</Color>    <!-- [补] 介于 ink-3 与 hairline 之间，仅禁用态 -->

    <!-- ================= 品牌独占色：朱砂（墨模式提亮） ================= -->
    <Color x:Key="Color.Primary">#FFE2564A</Color>               <!-- [稿] vermilion -->
    <Color x:Key="Color.PrimaryHover">#FFF08A7C</Color>          <!-- [稿] vermilion-deep -->
    <Color x:Key="Color.PrimaryPressed">#FFF7A79B</Color>        <!-- [稿] vermilion-ink -->
    <Color x:Key="Color.PrimaryContainer">#FF2A1310</Color>      <!-- [稿] vermilion-tint -->
    <Color x:Key="Color.PrimaryContainerHover">#FF3D1A14</Color> <!-- [稿] vermilion-soft -->
    <Color x:Key="Color.PrimaryText">#FFF08A7C</Color>           <!-- [稿] 文字级提亮，墨上 ≈ 7.1:1 -->
    <Color x:Key="Color.OnPrimary">#FF2B0B06</Color>             <!-- [稿] on-vermilion：亮朱砂上压深墨字 -->

    <!-- ================= 语义色 ================= -->
    <Color x:Key="Color.Error">#FFE8879A</Color>           <!-- [稿] danger：暗底上的冷绯 -->
    <Color x:Key="Color.ErrorContainer">#FF3A1A20</Color>  <!-- [稿] danger-soft -->
    <Color x:Key="Color.ErrorBorder">#FF57262E</Color>     <!-- [补] danger-soft 的加深描边 -->

    <!-- 成功 = 盖上了印：与 Primary 同源，是品牌决策不是笔误 -->
    <Color x:Key="Color.Success">#FFE2564A</Color>         <!-- [稿] 品牌规则：成功即朱砂 -->
    <Color x:Key="Color.SuccessContainer">#FF2A1310</Color><!-- [稿] vermilion-tint -->

    <Color x:Key="Color.Warning">#FFE0B45E</Color>         <!-- [稿] warn：藏印金一脉 -->
    <Color x:Key="Color.WarningContainer">#FF3A2E14</Color><!-- [稿] warn-soft -->
    <Color x:Key="Color.WarningBorder">#FF5A4520</Color>   <!-- [补] warn-soft 的加深描边 -->

    <!-- ================= 滚动条 =================
         暗底上绝不允许白色滚动条。拇指取 hairline-strong，悬停转朱砂。 -->
    <Color x:Key="Color.ScrollThumb">#FF343941</Color>          <!-- [稿] hairline-strong -->
    <Color x:Key="Color.ScrollThumbHover">#FFE2564A</Color>     <!-- [稿] hover 露出朱砂 -->
    <Color x:Key="Color.SealGold">#FFD8AB4A</Color>          <!-- [稿] 藏印金：墨底提亮后仍可读 -->

    <!-- 阴影：墨模式用纯黑，靠更大扩散做浮起（设计稿 shadow 为 rgba(0,0,0,.55)） -->
    <Color x:Key="Color.Shadow">#FF000000</Color>

    <!-- ================= 画刷 ================= -->
<SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}"/>
<SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}"/>
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="{StaticResource Color.SurfaceSubtle}"/>
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{StaticResource Color.SurfaceMuted}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}"/>
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}"/>
    <SolidColorBrush x:Key="Brush.PrimaryContainer" Color="{StaticResource Color.PrimaryContainer}"/>
    <SolidColorBrush x:Key="Brush.PrimaryContainerHover" Color="{StaticResource Color.PrimaryContainerHover}"/>
    <SolidColorBrush x:Key="Brush.PrimaryText" Color="{StaticResource Color.PrimaryText}"/>
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource Color.OnPrimary}"/>

    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.ErrorContainer" Color="{StaticResource Color.ErrorContainer}"/>
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="{StaticResource Color.ErrorBorder}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessContainer" Color="{StaticResource Color.SuccessContainer}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.WarningContainer" Color="{StaticResource Color.WarningContainer}"/>
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="{StaticResource Color.WarningBorder}"/>

    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}"/>

    <!-- 骑缝书脊：与纸主题同名同构，只换成暗底上的 hairline-strong。 -->
    <LinearGradientBrush x:Key="Brush.Spine" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00343941" Offset="0"/>
        <GradientStop Color="#CF343941" Offset="0.06"/>
        <GradientStop Color="#CF343941" Offset="0.91"/>
        <GradientStop Color="#00343941" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{StaticResource Color.ScrollThumbHover}"/>
    <SolidColorBrush x:Key="Brush.SealGold" Color="{StaticResource Color.SealGold}"/>

    <!-- ================= 译印中的进度笔迹（墨模式提亮） ================= -->
    <LinearGradientBrush x:Key="Brush.Signature.Streak" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E2564A" Offset="0"/>
        <GradientStop Color="#FFE2564A" Offset="0.25"/>
        <GradientStop Color="#FFE2564A" Offset="0.75"/>
        <GradientStop Color="#00E2564A" Offset="1"/>
    </LinearGradientBrush>

    <!-- ================= 截图遮罩（固定色，不随主题）=================
         与纸主题同值：截图场景恒为暗底。两份文件都写全，保证整本替换后键不缺。 -->
    <Color x:Key="Color.Capture.Scrim">#8C06080A</Color>
    <Color x:Key="Color.Capture.Selection">#FFE2564A</Color>
    <Color x:Key="Color.Capture.LabelBackground">#DB0D1015</Color>
    <Color x:Key="Color.Capture.LabelText">#FFEDEFF2</Color>
    <Color x:Key="Color.Capture.Guide">#33FFFFFF</Color>            <!-- [稿] rgba(255,255,255,.20) 贯穿虚线 -->
    <Color x:Key="Color.Capture.HudBorder">#24FFFFFF</Color>        <!-- [稿] rgba(255,255,255,.14) HUD 描边 -->
    <Color x:Key="Color.Capture.HintBackground">#B30D1015</Color>   <!-- [稿] rgba(13,16,21,.70) 底部提示底 -->
    <Color x:Key="Color.Capture.HintText">#9EEDEFF2</Color>         <!-- [稿] rgba(237,239,242,.62) 底部提示文字 -->
    <Color x:Key="Color.Capture.LoupeBackground">#E60D1015</Color>  <!-- [稿] rgba(13,16,21,.90) 放大镜底 -->
    <Color x:Key="Color.Capture.LoupeBorder">#29FFFFFF</Color>      <!-- [稿] rgba(255,255,255,.16) 放大镜描边 -->
    <Color x:Key="Color.Capture.LoupeGrid">#14FFFFFF</Color>        <!-- [稿] rgba(255,255,255,.08) 格子缝 -->
    <Color x:Key="Color.Capture.LoupeCell">#FF3C424C</Color>        <!-- [稿] 放大镜格子（取样前的底色） -->
    <Color x:Key="Color.Capture.OnSelection">#FFFFFFFF</Color>      <!-- [稿] 朱砂底上的白字 / 选区内侧白线 -->
    <SolidColorBrush x:Key="Brush.Capture.Scrim" Color="{StaticResource Color.Capture.Scrim}"/>
    <SolidColorBrush x:Key="Brush.Capture.Selection" Color="{StaticResource Color.Capture.Selection}"/>
    <SolidColorBrush x:Key="Brush.Capture.LabelBackground" Color="{StaticResource Color.Capture.LabelBackground}"/>
    <SolidColorBrush x:Key="Brush.Capture.LabelText" Color="{StaticResource Color.Capture.LabelText}"/>
    <SolidColorBrush x:Key="Brush.Capture.Guide" Color="{StaticResource Color.Capture.Guide}"/>
    <SolidColorBrush x:Key="Brush.Capture.HudBorder" Color="{StaticResource Color.Capture.HudBorder}"/>
    <SolidColorBrush x:Key="Brush.Capture.HintBackground" Color="{StaticResource Color.Capture.HintBackground}"/>
    <SolidColorBrush x:Key="Brush.Capture.HintText" Color="{StaticResource Color.Capture.HintText}"/>
    <SolidColorBrush x:Key="Brush.Capture.LoupeBackground" Color="{StaticResource Color.Capture.LoupeBackground}"/>
    <SolidColorBrush x:Key="Brush.Capture.LoupeBorder" Color="{StaticResource Color.Capture.LoupeBorder}"/>
    <SolidColorBrush x:Key="Brush.Capture.LoupeGrid" Color="{StaticResource Color.Capture.LoupeGrid}"/>
    <SolidColorBrush x:Key="Brush.Capture.LoupeCell" Color="{StaticResource Color.Capture.LoupeCell}"/>
    <SolidColorBrush x:Key="Brush.Capture.OnSelection" Color="{StaticResource Color.Capture.OnSelection}"/>

    <!-- ================= 内容覆盖层（固定色，不随主题）================= -->
    <Color x:Key="Color.Overlay.TextOnLight">#FF15181C</Color>
    <Color x:Key="Color.Overlay.TextOnDark">#FFF0F1F3</Color>
    <Color x:Key="Color.Overlay.CoverFallback">#FF8B9199</Color>
    <SolidColorBrush x:Key="Brush.Overlay.TextOnLight" Color="{StaticResource Color.Overlay.TextOnLight}"/>
    <SolidColorBrush x:Key="Brush.Overlay.TextOnDark" Color="{StaticResource Color.Overlay.TextOnDark}"/>
    <SolidColorBrush x:Key="Brush.Overlay.CoverFallback" Color="{StaticResource Color.Overlay.CoverFallback}"/>

    <Color x:Key="Color.TitleBarDark">#FF000000</Color>
</ResourceDictionary>
