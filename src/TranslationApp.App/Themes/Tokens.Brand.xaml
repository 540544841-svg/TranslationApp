<!--
  译印 INKSEAL · 品牌基础令牌（与主题无关）
  ============================================================================
  品牌故事：古人刻印，是为了让一件东西离开自己手里之后仍然算数——盖下去，
  就是确认。翻译是同一件事：原文在彼岸，译文在你这岸，中间必须有人落印；
  落下的那一刻，意思才算数。

  本文件只放「不随主题变化」的品牌资产：朱砂原色、刻痕几何、落印动效。
  会随主题变化的表面色/文字色放在 Tokens.Theme.Paper.xaml 与 Tokens.Theme.Ink.xaml。
  三个文件一同构成译印的完整色板（已取代琥珀 v2.0 的同名令牌）。

  语义规则（品牌自己讲的故事）：
    成功 = 盖上了印（朱砂）        失败 = 没盖上（冷绯 + 灰）
    所以两套主题里的 Color.Success 都指向朱砂，而不是绿色。

  合并位置：与 Tokens.Base.xaml 同级（[1]，主题色板之后、控件样式之前）。
  键名一律加 Brand. 前缀，与现有令牌零冲突。
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ==================== 印色 · 朱砂原色 ====================
         整套界面只有一种高饱和色相（暖红），深浅只靠明度分级。
         对应设计稿 inkseal-ui.html 的 vermilion / vermilion-deep / vermilion-ink。
         注释里引用 CSS 变量时省去了开头的两个短横线（XML 注释不允许连续短横线）。 -->
    <Color x:Key="Brand.Color.Vermilion">#FFC0392B</Color>      <!-- 朱砂：唯一强调色 -->
    <Color x:Key="Brand.Color.VermilionDeep">#FFA02E22</Color>  <!-- 深朱砂：hover / 文字级 -->
    <Color x:Key="Brand.Color.VermilionInk">#FF8A2419</Color>   <!-- 朱砂墨：pressed -->

    <!-- 藏印金：只出现在「藏印（生词本）」与收藏类标记上，是第二层级而非第二主色。
         此处登记的是纸上可用值；墨模式下需提亮到 #D8AB4A（设计稿 gold），
         墨主题里如用到请就地覆盖，不要直接引用本键。 -->
    <Color x:Key="Brand.Color.SealGold">#FFB98A1F</Color>

    <!-- ==================== 刻痕 · 形状语言 ====================
         全界面所有分割线 / 进度 / 选中指示都是同一道刻痕，且每道线都收在一粒
         45° 方菱形上——那正好是 logo 的中心。看一条线就知道是谁家的。

         落位规则（控件里必须一致）：
           · 横刻痕：右端收菱形（.carve），需要时左端也收（.carve.left）
           · 骑缝齿：1×6 竖条，间距 3，已盖印的齿为朱砂 -->
    <sys:Double x:Key="Brand.Chisel.Thickness">1</sys:Double>
    <sys:Double x:Key="Brand.Chisel.Diamond">6</sys:Double>
    <sys:Double x:Key="Brand.Chisel.TickWidth">1</sys:Double>
    <sys:Double x:Key="Brand.Chisel.TickHeight">6</sys:Double>
    <sys:Double x:Key="Brand.Chisel.TickGap">3</sys:Double>

    <!-- ==================== 印面圆角阶梯（设计稿原值）====================
         设计稿用的是 12 / 8 / 6 / 4，比现有 Tokens.Base.xaml 的 14 / 12 / 10 / 8 / 6 整体更方。
         若要整站套用，对照关系（需人工确认，勿盲改）：
           Radius.Window 14 -> 12     Radius.Card 12 -> 8     Radius.Field 10 -> 8
           Radius.Control 8 -> 6      Radius.Chip 6 -> 4
         先以 Brand. 前缀登记，控件可选用，不影响现有样式。 -->
    <CornerRadius x:Key="Brand.Radius.Window">12</CornerRadius>
    <CornerRadius x:Key="Brand.Radius.Seal">8</CornerRadius>
    <CornerRadius x:Key="Brand.Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Brand.Radius.Chip">4</CornerRadius>

    <!-- ==================== 落印 · 签名动效 ====================
         全界面只有一个签名动效，而且只押在一个时刻：译文落定。
         260ms，下沉过冲后回弹（cubic-bezier(.34,1.45,.5,1) -> KeySpline "0.34,1.45,0.5,1"），
         同时溢出一圈墨晕。失败时不落印，印面转成空心描边。 -->
    <Duration x:Key="Brand.Duration.Stamp">0:0:0.26</Duration>
    <Duration x:Key="Brand.Duration.Fast">0:0:0.12</Duration>
    <Duration x:Key="Brand.Duration.Base">0:0:0.18</Duration>

    <KeySpline x:Key="Brand.Ease.Stamp">0.34,1.45,0.5,1</KeySpline>  <!-- 落印：带过冲的回弹 -->
    <KeySpline x:Key="Brand.Ease.Standard">0.2,0,0,1</KeySpline>     <!-- 常规 -->
    <KeySpline x:Key="Brand.Ease.Out">0.33,1,0.68,1</KeySpline>      <!-- 入场 -->

</ResourceDictionary>
